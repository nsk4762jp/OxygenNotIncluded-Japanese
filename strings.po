msgid "A chubby baby <link=\"LIGHTBUG\">Shine Bug</link>."
msgstr "<link=\"LIGHTBUG\">シャインバグ</link>の丸ぽちゃな赤ちゃんです。"

#. STRINGS.CREATURES.SPECIES.LIGHTBUG.BABY.NAME
