msgstr "<link=\"EXTERIORWALL\">ノーティカル カーブ I</link>"

#. STRINGS.BLUEPRINTS.PERMIT_WALLS_STRIPES_CIRCLE_WHITE_NAUTICAL.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_STRIPES_CIRCLE_WHITE_NAUTICAL.DESC"
msgid "Alternating blue and white curves, with white on the outside."
msgstr "青と白の曲線が交互に並び、外側が白色になっています。"

#. STRINGS.BLUEPRINTS.PERMIT_WALLS_STRIPES_CIRCLE_WHITE_NAUTICAL.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_STRIPES_CIRCLE_WHITE_NAUTICAL.NAME"
