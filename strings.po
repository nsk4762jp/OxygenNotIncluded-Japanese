msgstr "帽子"

#. STRINGS.UI.SKILLS_SCREEN.SORT_BY_MORALE
msgctxt "STRINGS.UI.SKILLS_SCREEN.SORT_BY_MORALE"
msgid "Morale"
msgstr "士気"

#. STRINGS.UI.SKILLS_SCREEN.SORT_BY_SKILL_AVAILABLE
