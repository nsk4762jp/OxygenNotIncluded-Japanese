msgstr "泡と波の間に、飾り気のない羅針盤が浮かび上がります。"

#. STRINGS.BLUEPRINTS.PERMIT_WALLS_SEA_COMPASS.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_SEA_COMPASS.NAME"
msgid "<link=\"EXTERIORWALL\">Minimalist Compass Rose</link>"
msgstr "<link=\"EXTERIORWALL\">ミニマリスト羅針盤</link>"

