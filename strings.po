msgid "<link=\"WORMBASICFRUIT\">Spindly Grubfruit</link>"
msgstr "<link=\"WORMBASICFRUIT\">ひょろひょろグラブフルーツ</link>"

#. STRINGS.ITEMS.FOOD.WORMSUPERFOOD.DESC
msgctxt "STRINGS.ITEMS.FOOD.WORMSUPERFOOD.DESC"
msgid ""
"A long lasting <link=\"WORMSUPERFRUIT\">Grubfruit</link> jam preserved in <link=\"SUCROSE\">Sucrose</link>.\n"
"\n"
"The thick, goopy jam retains the shape of the jar when poured out, but the sweet taste can't be matched."
msgstr ""
"長期保存に向いた、<link=\"WORMSUPERFRUIT\">グラブフルーツ</link>を<link=\"SUCROSE\">スクロース</link>で漬け込んだジャムです。\n"
"\n"
"濃く、べたべたなジャムは瓶から取り出しても瓶の形を保っていますが、その甘さにはかないません。"

#. STRINGS.ITEMS.FOOD.WORMSUPERFOOD.NAME
msgctxt "STRINGS.ITEMS.FOOD.WORMSUPERFOOD.NAME"
msgid "<link=\"WORMSUPERFOOD\">Grubfruit Preserve</link>"
msgstr "<link=\"WORMSUPERFOOD\">グラブフルーツの瓶詰め</link>"

#. STRINGS.ITEMS.FOOD.WORMSUPERFOOD.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.WORMSUPERFOOD.RECIPEDESC"
