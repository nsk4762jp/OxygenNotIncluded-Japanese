msgid "<link=\"BOOSTEROP1\">Electrical Engineering Booster</link>"
msgstr "<link=\"BOOSTEROP1\">電気工学ブースター</link>"

#. STRINGS.ITEMS.BIONIC_BOOSTERS.BOOSTER_OP2.DESC
msgctxt "STRINGS.ITEMS.BIONIC_BOOSTERS.BOOSTER_OP2.DESC"
msgid "Grants a Bionic Duplicant complete mastery of engineering skills."
msgstr "バイオニック複製人間に完全なエンジニアリングスキルを付与します。"

