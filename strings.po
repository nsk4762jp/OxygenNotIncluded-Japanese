msgstr "閾値上限:"

#. STRINGS.BUILDINGS.PREFABS.SMARTRESERVOIR.SIDESCREEN_TITLE
msgctxt "STRINGS.BUILDINGS.PREFABS.SMARTRESERVOIR.SIDESCREEN_TITLE"
msgid "Logic Activation Parameters"
msgstr "論理起動パラメータ"

#. STRINGS.BUILDINGS.PREFABS.SMOKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SMOKER.DESC"
msgid "With a little patience, even tough meat can become deliciously edible."
msgstr "多少の手間暇をかければ、硬い肉でもおいしく食べられるようになります。"

#. STRINGS.BUILDINGS.PREFABS.SMOKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SMOKER.EFFECT"
msgid ""
"Cooks improved <link=\"FOOD\">foods</link> over low, slow heat.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"<link=\"FOOD\">食糧</link>を弱火でじっくり加熱調理します。\n"
"\n"
"レシピがセットされていないと複製人間は製作作業をしません。"

#. STRINGS.BUILDINGS.PREFABS.SMOKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SMOKER.NAME"
msgid "<link=\"SMOKER\">Smoker</link>"
msgstr "<link=\"SMOKER\">燻製器</link>"

#. STRINGS.BUILDINGS.PREFABS.SNOWTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SNOWTILE.DESC"
msgid "Snow tiles have low thermal conductivity, but will melt if temperatures get too high."
msgstr "雪製タイルは熱伝導率が低いですが、温度が高すぎると溶けてしまいます。"

#. STRINGS.BUILDINGS.PREFABS.SNOWTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SNOWTILE.EFFECT"
msgid ""
"Used to build the walls and floors of rooms.\n"
"\n"
"Insulates rooms to reduce <link=\"HEAT\">Heat</link> loss in cold climates."
msgstr ""
"部屋用の壁や床として使えるタイルです。\n"
"\n"
"部屋を断熱し、寒冷地での<link=\"HEAT\">熱</link>の損失を減らします。"

#. STRINGS.BUILDINGS.PREFABS.SNOWTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SNOWTILE.NAME"
msgid "<link=\"SNOWTILE\">Snow Tile</link>"
msgstr "<link=\"SNOWTILE\">雪タイル</link>"

# Sparkle と Twinkle で掛詞になっている
#. STRINGS.BUILDINGS.PREFABS.SODAFOUNTAIN.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SODAFOUNTAIN.DESC"
msgid "Sparkling water puts a twinkle in a Duplicant's eye."
msgstr "炭酸水は複製人間の目をパチパチさせます。"

#. STRINGS.BUILDINGS.PREFABS.SODAFOUNTAIN.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SODAFOUNTAIN.EFFECT"
msgid ""
"Creates soda from <link=\"WATER\">Water</link> and <link=\"CARBONDIOXIDE\">Carbon Dioxide</link>.\n"
"\n"
"Consuming soda water increases Duplicant <link=\"MORALE\">Morale</link>."
msgstr ""
"<link=\"WATER\">水</link>と<link=\"CARBONDIOXIDE\">二酸化炭素</link>から炭酸水を作ります。\n"
"\n"
"炭酸水は飲んだ複製人間の<link=\"MORALE\">士気</link>を高めます。"

#. STRINGS.BUILDINGS.PREFABS.SODAFOUNTAIN.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SODAFOUNTAIN.NAME"
msgid "<link=\"SODAFOUNTAIN\">Soda Fountain</link>"
msgstr "<link=\"SODAFOUNTAIN\">ソーダファウンテン</link>"

#. STRINGS.BUILDINGS.PREFABS.SOLARPANEL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLARPANEL.DESC"
msgid "Solar panels convert high intensity sunlight into power and produce zero waste."
msgstr "ソーラーパネルは強烈な太陽光を利用可能な電力に変換し、廃棄物が出ません。"

#. STRINGS.BUILDINGS.PREFABS.SOLARPANEL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLARPANEL.EFFECT"
msgid ""
"Converts <link=\"LIGHT\">Sunlight</link> into electrical <link=\"POWER\">Power</link>.\n"
"\n"
"Must be exposed to space."
msgstr ""
"<link=\"LIGHT\">太陽光</link>を<link=\"POWER\">電力</link>に変換します。\n"
"\n"
"宇宙空間に曝露されてないといけません。"

#. STRINGS.BUILDINGS.PREFABS.SOLARPANEL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLARPANEL.NAME"
msgid "<link=\"SOLARPANEL\">Solar Panel</link>"
msgstr "<link=\"SOLARPANEL\">ソーラーパネル</link>"

#. STRINGS.BUILDINGS.PREFABS.SOLARPANELMODULE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLARPANELMODULE.DESC"
msgid "Collect solar energy before takeoff and during flight."
msgstr "発射前および航行中に太陽光エネルギーを収集します。"

#. STRINGS.BUILDINGS.PREFABS.SOLARPANELMODULE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLARPANELMODULE.EFFECT"
msgid ""
"Converts <link=\"LIGHT\">Sunlight</link> into electrical <link=\"POWER\">Power</link> for use on rockets.\n"
"\n"
"Must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>. \n"
"\n"
"Must be exposed to space."
msgstr ""
"ロケットで使用するために<link=\"LIGHT\">太陽光</link>を<link=\"POWER\">電力</link>に変換します。\n"
"\n"
"<link=\"LAUNCHPAD\">ロケット発射台</link>経由で建築する必要があります。\n"
"\n"
"宇宙空間に曝露されている必要があります。"

#. STRINGS.BUILDINGS.PREFABS.SOLARPANELMODULE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLARPANELMODULE.NAME"
msgid "<link=\"SOLARPANELMODULE\">Solar Panel Module</link>"
msgstr "<link=\"SOLARPANELMODULE\">ソーラーパネルモジュール</link>"

#. STRINGS.BUILDINGS.PREFABS.SOLIDBOOSTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDBOOSTER.DESC"
msgid "Additional thrusters allow rockets to reach far away space destinations."
msgstr "追加スラスターはロケットをより遠くまで飛ばすことができます。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDBOOSTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDBOOSTER.EFFECT"
msgid "Burns <link=\"IRON\">Iron</link> and <link=\"OXYROCK\">Oxylite</link> to increase rocket exploration distance."
msgstr "<link=\"IRON\">鉄</link>と<link=\"OXYROCK\">オキシライト</link>を燃焼させ、航続距離を伸ばします。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDBOOSTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDBOOSTER.NAME"
msgid "<link=\"SOLIDBOOSTER\">Solid Fuel Thruster</link>"
msgstr "<link=\"SOLIDBOOSTER\">固体燃料スラスター</link>"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCARGOBAYSMALL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCARGOBAYSMALL.DESC"
msgid "Duplicants will fill cargo bays with any resources they find during space missions."
msgstr "複製人間は宇宙ミッション中に見つけた資源を貨物ベイに保管します。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCARGOBAYSMALL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCARGOBAYSMALL.EFFECT"
msgid ""
"Allows Duplicants to store some of the <link=\"ELEMENTSSOLID\">Solid Materials</link> found during space missions.\n"
"\n"
"Stored resources become available to the colony upon the rocket's return. \n"
"\n"
"Must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr ""
"複製人間は宇宙ミッション中に見つけた<link=\"ELEMENTSSOLID\">固形素材</link>を格納します。\n"
"\n"
"格納された資源はロケット帰還時に利用可能となります。\n"
"\n"
"<link=\"LAUNCHPAD\">ロケット発射台</link>経由で建築する必要があります。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCARGOBAYSMALL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCARGOBAYSMALL.NAME"
msgid "<link=\"SOLIDCARGOBAYSMALL\">Cargo Bay</link>"
msgstr "<link=\"SOLIDCARGOBAYSMALL\">貨物ベイ</link>"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUIT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUIT.DESC"
msgid "Rails move materials where they'll be needed most, saving Duplicants the walk."
msgstr "レールは素材を必要な場所へ自動的に輸送します。複製人間の足を節約できます。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUIT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUIT.EFFECT"
msgid ""
"Transports <link=\"ELEMENTSSOLID\">Solid Materials</link> on a track between <link=\"SOLIDCONDUITINBOX\">Conveyor Loader</link> and <link=\"SOLIDCONDUITOUTBOX\">Conveyor Receptacle</link>.\n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"<link=\"ELEMENTSSOLID\">固形素材</link>を <link=\"SOLIDCONDUITINBOX\">コンベア ローダー</link>から<link=\"SOLIDCONDUITOUTBOX\">コンベア レセプター</link>まで輸送します。\n"
"\n"
"壁タイルや床タイルの中を通すことができます。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUIT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUIT.NAME"
msgid "<link=\"SOLIDCONDUIT\">Conveyor Rail</link>"
msgstr "<link=\"SOLIDCONDUIT\">コンベアレール</link>"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITBRIDGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITBRIDGE.DESC"
msgid "Separating rail systems helps ensure materials go to the intended destinations."
msgstr "レールの系統を分けることで、素材が誤った地点へ送られるのを防げます。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITBRIDGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITBRIDGE.EFFECT"
msgid ""
"Runs one <link=\"SOLIDCONDUIT\">Conveyor Rail</link> section over another without joining them.\n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"別の<link=\"SOLIDCONDUIT\">コンベアレール</link>に干渉することなく交差できます。\n"
"\n"
"壁タイルや床タイルの中を通すことができます。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITBRIDGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITBRIDGE.NAME"
msgid "<link=\"SOLIDCONDUITBRIDGE\">Conveyor Bridge</link>"
msgstr "<link=\"SOLIDCONDUITBRIDGE\">コンベアブリッジ</link>"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITDISEASESENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITDISEASESENSOR.DESC"
msgid "Germ sensors can help control automation behavior in the presence of germs."
msgstr "病原菌センサーは、病原菌の有無によって動きを変える自動化制御に使います。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITDISEASESENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITDISEASESENSOR.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> based on the internal <link=\"DISEASE\">Germ</link> count of the object on the rail."
msgstr "レール上のオブジェクト表面に存在する<link=\"DISEASE\">病原菌</link>の濃度によって、<b><style=\"logic_on\">グリーン</style></b>または<b><style=\"logic_off\">レッド</style></b>になります。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITDISEASESENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITDISEASESENSOR.LOGIC_PORT"
msgid "Internal <link=\"DISEASE\">Germ</link> Count"
msgstr "内部<link=\"DISEASE\">病原菌</link>濃度"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITDISEASESENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITDISEASESENSOR.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if the number of Germs on the object on the rail is within the selected range"
msgstr "レール上にあるオブジェクト表面の病原菌が指定した範囲内にある時、<b><style=\"logic_on\">グリーン</style></b>になります"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITDISEASESENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITDISEASESENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "そうでない場合、<b><style=\"logic_off\">レッド</style></b>になります"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITDISEASESENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITDISEASESENSOR.NAME"
msgid "<link=\"SOLIDCONDUITDISEASESENSOR\">Conveyor Rail Germ Sensor</link>"
msgstr "<link=\"SOLIDCONDUITDISEASESENSOR\">コンベアレール 病原菌センサー</link>"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITELEMENTSENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITELEMENTSENSOR.DESC"
msgid "Element sensors can be used to detect the presence of a specific item on a rail."
msgstr "元素センサーはレール上にある特定の物体を検出します。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITELEMENTSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITELEMENTSENSOR.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when the selected item is detected on a rail."
msgstr "指定した物体を検出すると<b><style=\"logic_on\">グリーン</style></b>になります。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITELEMENTSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITELEMENTSENSOR.LOGIC_PORT"
msgid "Internal <link=\"ELEMENTSLIQUID\">Item</link> Presence"
msgstr "内部<link=\"ELEMENTSLIQUID\">物体</link>判定"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITELEMENTSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITELEMENTSENSOR.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if the configured item is detected on the rail"
msgstr "レール上に設定した物体を検出すると<b><style=\"logic_on\">グリーン</style></b>になります"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITELEMENTSENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITELEMENTSENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "そうでない場合、<b><style=\"logic_off\">レッド</style></b>になります"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITELEMENTSENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITELEMENTSENSOR.NAME"
msgid "<link=\"SOLIDCONDUITELEMENTSENSOR\">Conveyor Rail Element Sensor</link>"
msgstr "<link=\"SOLIDCONDUITELEMENTSENSOR\">コンベアレール 元素センサー</link>"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITINBOX.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITINBOX.DESC"
msgid "Material filters can be used to determine what resources are sent down the rail."
msgstr "素材フィルターはどの素材を送り出すか決定するのに使います。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITINBOX.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITINBOX.EFFECT"
msgid ""
"Loads <link=\"ELEMENTSSOLID\">Solid Materials</link> onto <link=\"SOLIDCONDUIT\">Conveyor Rail</link> for transport.\n"
"\n"
"Only loads the resources of your choosing."
msgstr ""
"輸送用に<link=\"ELEMENTSSOLID\">固形素材</link>を<link=\"SOLIDCONDUIT\">コンベアレール</link>に積載します。\n"
"\n"
"選んだ資源のみ積載できます。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITINBOX.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITINBOX.NAME"
msgid "<link=\"SOLIDCONDUITINBOX\">Conveyor Loader</link>"
msgstr "<link=\"SOLIDCONDUITINBOX\">コンベアローダー</link>"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITOUTBOX.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITOUTBOX.DESC"
msgid "When materials reach the end of a rail they enter a receptacle to be used by Duplicants."
msgstr "素材がレールの終端に達するとレセプターへ収納され、複製人間が利用できるようになります。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITOUTBOX.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITOUTBOX.EFFECT"
msgid "Unloads <link=\"ELEMENTSSOLID\">Solid Materials</link> from a <link=\"SOLIDCONDUIT\">Conveyor Rail</link> into storage."
msgstr "<link=\"SOLIDCONDUIT\">コンベアレール</link>上の<link=\"ELEMENTSSOLID\">固形素材</link>を自身の内容物として受け取ります。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITOUTBOX.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITOUTBOX.NAME"
msgid "<link=\"SOLIDCONDUITOUTBOX\">Conveyor Receptacle</link>"
msgstr "<link=\"SOLIDCONDUITOUTBOX\">コンベアレセプター</link>"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITTEMPERATURESENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITTEMPERATURESENSOR.DESC"
msgid "Thermo sensors disable buildings when their rail contents reach a certain temperature."
msgstr "温度センサーはレール上にある物体が特定の温度に達した時に設備を自動停止させることができます。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITTEMPERATURESENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITTEMPERATURESENSOR.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> when rail contents enter the chosen <link=\"HEAT\">Temperature</link> range."
msgstr "レール上にある物体の<link=\"HEAT\">温度</link>が指定した範囲内にある時、<b><style=\"logic_on\">グリーン</style></b>または<b><style=\"logic_off\">レッド</style></b>になります。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITTEMPERATURESENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITTEMPERATURESENSOR.LOGIC_PORT"
msgid "Internal Item <link=\"HEAT\">Temperature</link>"
msgstr "内部物体<link=\"HEAT\">温度</link>"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITTEMPERATURESENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITTEMPERATURESENSOR.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if the contained item is within the selected Temperature range"
msgstr "内容物の気体温度が指定した範囲内にある時、<b><style=\"logic_on\">グリーン</style></b>になります"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITTEMPERATURESENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITTEMPERATURESENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "そうでない場合、<b><style=\"logic_off\">レッド</style></b>になります"

#. STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITTEMPERATURESENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITTEMPERATURESENSOR.NAME"
msgid "<link=\"SOLIDCONDUITTEMPERATURESENSOR\">Conveyor Rail Thermo Sensor</link>"
msgstr "<link=\"SOLIDCONDUITTEMPERATURESENSOR\">コンベアレール 温度センサー</link>"

#. STRINGS.BUILDINGS.PREFABS.SOLIDFILTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDFILTER.DESC"
msgid "All solids are sent into the building's output conveyor, except the solid chosen for filtering."
msgstr "フィルター指定した資源を除く全ての固形素材が、コンベア出口に繫いだレールへ流れます。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDFILTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDFILTER.EFFECT"
msgid "Separates one <link=\"ELEMENTSSOLID\">Solid Material</link> from the conveyor, sending it into a dedicated <link=\"SOLIDCONDUIT\">Conveyor Rail</link>."
msgstr ""
"コンベアから指定した<link=\"ELEMENTSSOLID\">固形素材</link>を分別し、専用の<style=\"KKeyword\">コンベア出口</style>から<link=\"SOLIDCONDUIT\">コンベアレール</link>へ流します。\n"
"\n"
"分別できる固形素材は一度に一種類だけです。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDFILTER.ELEMENT_NOT_SPECIFIED
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDFILTER.ELEMENT_NOT_SPECIFIED"
msgid "Not Specified"
msgstr "指定なし"

#. STRINGS.BUILDINGS.PREFABS.SOLIDFILTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDFILTER.NAME"
msgid "<link=\"SOLIDFILTER\">Solid Filter</link>"
msgstr "<link=\"SOLIDFILTER\">固体フィルター</link>"

#. STRINGS.BUILDINGS.PREFABS.SOLIDFILTER.STATUS_ITEM
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDFILTER.STATUS_ITEM"
msgid "Filters: {0}"
msgstr "フィルター: {0}"

#. STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.DESC"
msgid "Conveyor Meters let an exact amount of materials pass through before shutting off."
msgstr "コンベアメーターは正確な量の素材を通すとバルブが閉じます。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.EFFECT"
msgid "Connects to an <link=\"LOGIC\">Automation</link> grid to automatically turn material transfer off when the specified amount has passed through it."
msgstr "特定量を通した後で素材の輸送をオフにできるよう、<link=\"LOGIC\">自動化</link>ネットワークに接続します。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.LOGIC_PORT_OUTPUT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.LOGIC_PORT_OUTPUT"
msgid "Limit Reached"
msgstr "制限到達"

#. STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.LOGIC_PORT_RESET
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.LOGIC_PORT_RESET"
msgid "Reset Meter"
msgstr "メーターリセット"

#. STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.NAME"
msgid "<link=\"SOLIDLIMITVALVE\">Conveyor Meter</link>"
msgstr "<link=\"SOLIDLIMITVALVE\">コンベアメーター</link>"

#. STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.OUTPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.OUTPUT_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if limit has been reached"
msgstr "制限量に到達すると<b><style=\"logic_on\">グリーン</style></b>になります"

#. STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.OUTPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.OUTPUT_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "そうでない場合、<b><style=\"logic_off\">レッド</style></b>になります"

#. STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.RESET_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.RESET_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Reset the amount"
msgstr "<b><style=\"logic_on\">グリーン</style></b>: 制限量に到達"

#. STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.RESET_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.RESET_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Nothing"
msgstr "<b><style=\"logic_off\">レッド</style></b>: 効果なし"

#. STRINGS.BUILDINGS.PREFABS.SOLIDLOGICVALVE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLOGICVALVE.DESC"
msgid "Automated conveyors save power and time by removing the need for Duplicant input."
msgstr "コンベアは複製人間の手間を減らし、時間と電力を節約します。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDLOGICVALVE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLOGICVALVE.EFFECT"
msgid "Connects to an <link=\"LOGIC\">Automation</link> grid to automatically turn <link=\"ELEMENTSSOLID\">Solid Material</link> transport on or off."
msgstr "<link=\"ELEMENTSSOLID\">固形素材</link>を輸送できるよう、<link=\"LOGIC\">自動化</link>ネットワークに接続します。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDLOGICVALVE.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLOGICVALVE.LOGIC_PORT"
msgid "Open/Close"
msgstr "開閉"

#. STRINGS.BUILDINGS.PREFABS.SOLIDLOGICVALVE.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLOGICVALVE.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Allow material transport"
msgstr "<b><style=\"logic_on\">グリーン</style></b>: 素材を輸送する"

#. STRINGS.BUILDINGS.PREFABS.SOLIDLOGICVALVE.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLOGICVALVE.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Prevent material transport"
msgstr "<b><style=\"logic_off\">レッド</style></b>: 素材を輸送しない"

#. STRINGS.BUILDINGS.PREFABS.SOLIDLOGICVALVE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLOGICVALVE.NAME"
msgid "<link=\"SOLIDLOGICVALVE\">Conveyor Shutoff</link>"
msgstr "<link=\"SOLIDLOGICVALVE\">コンベア遮断器</link>"

#. STRINGS.BUILDINGS.PREFABS.SOLIDTRANSFERARM.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDTRANSFERARM.DESC"
msgid "An auto-sweeper's range can be viewed at any time by (ClickType/clicking) on the building."
msgstr "自動掃除機の吸引範囲は設備を (ClickType/clicking) にすることでいつでも確認できます。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDTRANSFERARM.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDTRANSFERARM.EFFECT"
msgid ""
"Automates <link=\"CHORES\">Sweeping</link> and <link=\"CHORES\">Supplying</link> errands by sucking up all nearby <link=\"DECOR\">Debris</link>.\n"
"\n"
"Materials are automatically delivered to any <link=\"SOLIDCONDUITINBOX\">Conveyor Loader</link>, <link=\"SOLIDCONDUITOUTBOX\">Conveyor Receptacle</link>, storage, or buildings within range."
msgstr ""
"付近の<link=\"DECOR\">がれき</link>を吸い上げて、<link=\"CHORES\">片付け</link>と<link=\"CHORES\">配達</link>の作業を自動的に行います。\n"
"\n"
"吸い上げられた素材は、掃除機の吸引範囲内にある運搬先(<link=\"SOLIDCONDUITINBOX\">コンベアローダー</link>、<link=\"SOLIDCONDUITOUTBOX\">コンベアレセプター</link>などの収納設備や、範囲内の設備)へ自動的に届けられます。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDTRANSFERARM.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDTRANSFERARM.NAME"
msgid "<link=\"SOLIDTRANSFERARM\">Auto-Sweeper</link>"
msgstr "<link=\"SOLIDTRANSFERARM\">自動掃除機</link>"

#. STRINGS.BUILDINGS.PREFABS.SOLIDVENT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDVENT.DESC"
msgid "When materials reach the end of a rail they are dropped back into the world."
msgstr "素材がレール終端に来ると、地面に落下します。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDVENT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDVENT.EFFECT"
msgid "Unloads <link=\"ELEMENTSSOLID\">Solid Materials</link> from a <link=\"SOLIDCONDUIT\">Conveyor Rail</link> onto the floor."
msgstr "<link=\"ELEMENTSSOLID\">固形素材</link>を<link=\"SOLIDCONDUIT\">コンベアレール</link>から荷下します。"

#. STRINGS.BUILDINGS.PREFABS.SOLIDVENT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDVENT.NAME"
msgid "<link=\"SOLIDVENT\">Conveyor Chute</link>"
msgstr "<link=\"SOLIDVENT\">コンベアシュート</link>"

#. STRINGS.BUILDINGS.PREFABS.SPACEHEATER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SPACEHEATER.DESC"
msgid "Space heaters are a welcome cure for cold, soggy feet."
msgstr "空間ヒーターは寒くて濡れた足を温めるのに最適です。"

#. STRINGS.BUILDINGS.PREFABS.SPACEHEATER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SPACEHEATER.EFFECT"
msgid ""
"Radiates a moderate amount of <link=\"HEAT\">Heat</link>.\n"
"\n"
"Requires <link=\"POWER\">Power</link> in order to function."
msgstr ""
"適度な量の<link=\"HEAT\">熱</link>を放射します。\n"
"稼働するためには<link=\"POWER\">電力</link>が必要です。"

#. STRINGS.BUILDINGS.PREFABS.SPACEHEATER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SPACEHEATER.NAME"
msgid "<link=\"SPACEHEATER\">Space Heater</link>"
msgstr "<link=\"SPACEHEATER\">空間ヒーター</link>"

#. STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAY.DESC"
msgid "Biological cargo bays allow Duplicants to retrieve alien plants and wildlife from space."
msgstr "有機体貨物ベイは複製人間に外宇宙の生物や植物を回収させることができます。"

#. STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAY.EFFECT"
msgid ""
"Allows Duplicants to store unusual or organic resources found during space missions.\n"
"\n"
"Stored resources become available to the colony upon the rocket's return."
msgstr ""
"複製人間は宇宙ミッション中に見つけた珍しい有機体資源を格納します。\n"
"\n"
"格納された資源はロケット帰還時に利用可能となります。"

#. STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAY.NAME"
msgid "<link=\"SPECIALCARGOBAY\">Biological Cargo Bay</link>"
msgstr "<link=\"SPECIALCARGOBAY\">有機体貨物ベイ</link>"

#. STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAYCLUSTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAYCLUSTER.DESC"
msgid "Critters do not require feeding during transit."
msgstr "輸送中の動物は餌を必要としません。"

#. STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAYCLUSTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAYCLUSTER.EFFECT"
msgid ""
"Allows Duplicants to transport <link=\"CREATURES\">Critters</link> through space.\n"
"\n"
"Specimens can be released into the colony upon the rocket's return.\n"
"\n"
"Must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr ""
"複製人間が宇宙を跨いで<link=\"CREATURES\">動物</link>を輸送できるようにします。\n"
"\n"
"格納された動物はロケット帰還時に解放できます。\n"
"\n"
"<link=\"LAUNCHPAD\">ロケット発射台</link>経由で建築する必要があります。"

#. STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAYCLUSTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAYCLUSTER.NAME"
msgid "<link=\"SPECIALCARGOBAYCLUSTER\">Critter Cargo Bay</link>"
msgstr "<link=\"SPECIALCARGOBAYCLUSTER\">動物貨物ベイ</link>"

#. STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAYCLUSTER.RELEASE_BTN
msgctxt "STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAYCLUSTER.RELEASE_BTN"
msgid "Release Critter"
msgstr "動物解放"

#. STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAYCLUSTER.RELEASE_BTN_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAYCLUSTER.RELEASE_BTN_TOOLTIP"
msgid "Release the critter stored inside"
msgstr "内部の動物を解放します"

#. STRINGS.BUILDINGS.PREFABS.SPICEGRINDER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SPICEGRINDER.DESC"
msgid "Crushed seeds and other edibles make excellent meal-enhancing additives."
msgstr "種子やその他の食物を砕いたものは、食事に最適な添加物となります。"

#. STRINGS.BUILDINGS.PREFABS.SPICEGRINDER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SPICEGRINDER.EFFECT"
msgid "Produces ingredients that add benefits to <link=\"FOOD\">foods</link> prepared at skilled cooking stations."
msgstr "高機能な調理端末で作られた<link=\"FOOD\">食糧</link>にメリットを付与する材料を生産します。"

#. STRINGS.BUILDINGS.PREFABS.SPICEGRINDER.INGREDIENTHEADER
msgctxt "STRINGS.BUILDINGS.PREFABS.SPICEGRINDER.INGREDIENTHEADER"
msgid "Ingredients per 1000kcal:"
msgstr "1000kcal あたりの材料:"

#. STRINGS.BUILDINGS.PREFABS.SPICEGRINDER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SPICEGRINDER.NAME"
msgid "<link=\"SPICEGRINDER\">Spice Grinder</link>"
msgstr "<link=\"SPICEGRINDER\">スパイスミル</link>"

#. STRINGS.BUILDINGS.PREFABS.STATERPILLAREGG.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STATERPILLAREGG.DESC"
msgid "The electrifying egg of the <link=\"STATERPILLAR\">Plug Slug</link>."
msgstr "<link=\"STATERPILLAR\">びりびりナメクジ</link>の帯電した卵です。"

#. STRINGS.BUILDINGS.PREFABS.STATERPILLAREGG.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.STATERPILLAREGG.EFFECT"
msgid "Slug Eggs can be connected to a <link=\"POWER\">Power</link> circuit as an energy source."
msgstr "スラッグの卵は<link=\"POWER\">電気</link>回路と繋げることで電源として利用できます。"

#. STRINGS.BUILDINGS.PREFABS.STATERPILLAREGG.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STATERPILLAREGG.NAME"
msgid "<link=\"STATERPILLAREGG\">Slug Egg</link>"
msgstr "<link=\"STATERPILLAREGG\">スラッグの卵</link>"

#. STRINGS.BUILDINGS.PREFABS.STATERPILLARGENERATOR.MODIFIERS.HUNGRY
msgctxt "STRINGS.BUILDINGS.PREFABS.STATERPILLARGENERATOR.MODIFIERS.HUNGRY"
msgid "Hungry!"
msgstr "はらぺこだぁ！"

#. STRINGS.BUILDINGS.PREFABS.STATERPILLARGENERATOR.MODIFIERS.WILD
msgctxt "STRINGS.BUILDINGS.PREFABS.STATERPILLARGENERATOR.MODIFIERS.WILD"
msgid "Wild!"
msgstr "ワイルドだぜぇ！"

#. STRINGS.BUILDINGS.PREFABS.STATERPILLARGENERATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STATERPILLARGENERATOR.NAME"
msgid "<link=\"STATERPILLAR\">Plug Slug</link>"
msgstr "<link=\"STATERPILLAR\">びりびりナメクジ</link>"

#. STRINGS.BUILDINGS.PREFABS.STEAMENGINE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMENGINE.DESC"
msgid "Rockets can be used to send Duplicants into space and retrieve rare resources."
msgstr "ロケットは複製人間を宇宙に送り出し、貴重な資源を回収してきます。"

#. STRINGS.BUILDINGS.PREFABS.STEAMENGINE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMENGINE.EFFECT"
msgid ""
"Utilizes <link=\"STEAM\">Steam</link> to propel rockets for space exploration.\n"
"\n"
"The engine of a rocket must be built first before more rocket modules may be added."
msgstr ""
"<link=\"STEAM\">蒸気</link>を活用し、宇宙探索ロケットの推進力とします。\n"
"\n"
"ロケットのエンジンは他のどのロケットモジュールよりも最初に建築する必要があります。"

#. STRINGS.BUILDINGS.PREFABS.STEAMENGINE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMENGINE.NAME"
msgid "<link=\"STEAMENGINE\">Steam Engine</link>"
msgstr "<link=\"STEAMENGINE\">蒸気エンジン</link>"

#. STRINGS.BUILDINGS.PREFABS.STEAMENGINECLUSTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMENGINECLUSTER.DESC"
msgid "Rockets can be used to send Duplicants into space and retrieve rare resources."
msgstr "ロケットは複製人間を宇宙に送り出し、貴重な資源を回収します。"

#. STRINGS.BUILDINGS.PREFABS.STEAMENGINECLUSTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMENGINECLUSTER.EFFECT"
msgid ""
"Utilizes <link=\"STEAM\">Steam</link> to propel rockets for space exploration.\n"
"\n"
"Engine must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>. \n"
"\n"
"Once the engine has been built, more rocket modules can be added."
msgstr ""
"<link=\"STEAM\">蒸気</link>を活用し、宇宙探索ロケットの推進力とします。\n"
"\n"
"エンジンは<link=\"LAUNCHPAD\">ロケット発射台</link>経由で建築する必要があります。\n"
"\n"
"ロケットのエンジンは他のどのロケットモジュールよりも最初に建築する必要があります。"

#. STRINGS.BUILDINGS.PREFABS.STEAMENGINECLUSTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMENGINECLUSTER.NAME"
msgid "<link=\"STEAMENGINECLUSTER\">Steam Engine</link>"
msgstr "<link=\"STEAMENGINECLUSTER\">蒸気エンジン</link>"

#. STRINGS.BUILDINGS.PREFABS.STEAMTURBINE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMTURBINE.DESC"
msgid "Useful for converting the geothermal energy of magma into usable power."
msgstr "マグマの地熱エネルギーを利用可能な電力に変換するのに役立ちます。"

#. STRINGS.BUILDINGS.PREFABS.STEAMTURBINE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMTURBINE.EFFECT"
msgid ""
"THIS BUILDING HAS BEEN DEPRECATED AND CANNOT BE BUILT.\n"
"\n"
"Generates exceptional electrical <link=\"POWER\">Power</link> using pressurized, <link=\"HEAT\">Scalding</link> <link=\"STEAM\">Steam</link>.\n"
"\n"
"Outputs significantly cooler <link=\"STEAM\">Steam</link> than it receives.\n"
"\n"
"Air pressure beneath this building must be higher than pressure above for air to flow."
msgstr ""
"この設備は陳腐化したため、建築できません。\n"
"\n"
"高圧で<link=\"HEAT\">高熱</link>の<link=\"STEAM\">水蒸気</link>を使って<link=\"POWER\">電力</link>を生成します。\n"
"\n"
"受け取った<link=\"STEAM\">蒸気</link>は冷却されて排出されます。\n"
"\n"
"気流の都合上、この設備の下側の気圧は上側の気圧より高くなければなりません。"

#. STRINGS.BUILDINGS.PREFABS.STEAMTURBINE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMTURBINE.NAME"
msgid "<link=\"STEAMTURBINE\">[DEPRECATED] Steam Turbine</link>"
msgstr "<link=\"STEAMTURBINE\">[陳腐化] 蒸気タービン</link>"

#. STRINGS.BUILDINGS.PREFABS.STEAMTURBINE2.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMTURBINE2.DESC"
msgid "Useful for converting the geothermal energy into usable power."
msgstr "地熱エネルギーを利用可能な電力に変換するのに役立ちます。"

#. STRINGS.BUILDINGS.PREFABS.STEAMTURBINE2.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMTURBINE2.EFFECT"
msgid ""
"Draws in <link=\"STEAM\">Steam</link> from the tiles directly below the machine's foundation and uses it to generate electrical <link=\"POWER\">Power</link>.\n"
"\n"
"Outputs <link=\"WATER\">Water</link>."
msgstr ""
"この機械の真下にあるタイルから<link=\"STEAM\">蒸気</link>を吸い込み、<link=\"POWER\">発電</link>に使用します。\n"
"\n"
"<link=\"WATER\">水</link>を出力します。"

#. STRINGS.BUILDINGS.PREFABS.STEAMTURBINE2.HEAT_SOURCE
msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMTURBINE2.HEAT_SOURCE"
msgid "Power Generation Waste"
msgstr "発電による排熱"

#. STRINGS.BUILDINGS.PREFABS.STEAMTURBINE2.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMTURBINE2.NAME"
msgid "<link=\"STEAMTURBINE2\">Steam Turbine</link>"
msgstr "<link=\"STEAMTURBINE2\">蒸気タービン</link>"

#. STRINGS.BUILDINGS.PREFABS.STICKERBOMB.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STICKERBOMB.DESC"
msgid "Surprise decor sneak attacks a Duplicant's gloomy day."
msgstr "複製人間の憂鬱な一日をびっくりシールで吹き飛ばしましょう。"

#. STRINGS.BUILDINGS.PREFABS.STICKERBOMB.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STICKERBOMB.NAME"
msgid "<link=\"STICKERBOMB\">Sticker Bomb</link>"
msgstr "<link=\"STICKERBOMB\">ステッカーボム</link>"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.DESC"
msgid "Resources left on the floor become \"debris\" and lower decor when not put away."
msgstr "床に放置された資源は「がれき」扱いとなり、美観を損ねます。"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.EFFECT"
msgid "Stores the <link=\"ELEMENTSSOLID\">Solid Materials</link> of your choosing."
msgstr "指定した<link=\"ELEMENTSSOLID\">固形素材</link>を収納します。"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.BLUE_BABYTEARS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.BLUE_BABYTEARS.DESC"
msgid "Color-coded storage makes things easier to find."
msgstr "色分けされた収納庫は物を見つけやすくします。"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.BLUE_BABYTEARS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.BLUE_BABYTEARS.NAME"
msgid "<link=\"STORAGELOCKER\">Weepy Blue Storage Bin</link>"
msgstr "<link=\"STORAGELOCKER\">涙もろい青の収納庫</link>"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.DEFAULT_STORAGELOCKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.DEFAULT_STORAGELOCKER.DESC"
msgid "Resources left on the floor become \"debris\" and lower decor when not put away."
msgstr "床に放置された資源は「がれき」扱いとなり、美観を損ねます。"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.DEFAULT_STORAGELOCKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.DEFAULT_STORAGELOCKER.NAME"
msgid "<link=\"STORAGELOCKER\">Storage Bin</link>"
msgstr "<link=\"STORAGELOCKER\">収納庫</link>"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.GREEN_MUSH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.GREEN_MUSH.DESC"
msgid "Color-coded storage makes things easier to find."
msgstr "色分けされた収納庫は物を見つけやすくします。"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.GREEN_MUSH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.GREEN_MUSH.NAME"
msgid "<link=\"STORAGELOCKER\">Mush Green Storage Bin</link>"
msgstr "<link=\"STORAGELOCKER\">どろどろ緑の収納庫</link>"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.POLKA_DARKNAVYNOOKGREEN.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.POLKA_DARKNAVYNOOKGREEN.DESC"
msgid "A fun storage solution for fun-damental materials."
msgstr "基本的な素材のための楽しい格納ソリューションです。"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.POLKA_DARKNAVYNOOKGREEN.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.POLKA_DARKNAVYNOOKGREEN.NAME"
msgid "<link=\"STORAGELOCKER\">Party Dot Storage Bin</link>"
msgstr "<link=\"STORAGELOCKER\">パーティードットの収納庫</link>"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.POLKA_DARKPURPLERESIN.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.POLKA_DARKPURPLERESIN.DESC"
msgid "Groovy storage, because messy colonies are such a drag."
msgstr "コロニーが乱雑になると非常に面倒なので、保管場所は整理整頓されています。"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.POLKA_DARKPURPLERESIN.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.POLKA_DARKPURPLERESIN.NAME"
msgid "<link=\"STORAGELOCKER\">Mod Dot Storage Bin</link>"
msgstr "<link=\"STORAGELOCKER\">モッドドットの収納庫</link>"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.PURPLE_BRAINFAT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.PURPLE_BRAINFAT.DESC"
msgid "Color-coded storage makes things easier to find."
msgstr "色分けされた収納庫は物を見つけやすくします。"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.PURPLE_BRAINFAT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.PURPLE_BRAINFAT.NAME"
msgid "<link=\"STORAGELOCKER\">Faint Purple Storage Bin</link>"
msgstr "<link=\"STORAGELOCKER\">薄紫の収納庫</link>"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.RED_ROSE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.RED_ROSE.DESC"
msgid "Color-coded storage makes things easier to find."
msgstr "色分けされた収納庫は物を見つけやすくします。"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.RED_ROSE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.RED_ROSE.NAME"
msgid "<link=\"STORAGELOCKER\">Puce Pink Storage Bin</link>"
msgstr "<link=\"STORAGELOCKER\">暗いピンクの収納庫</link>"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.STRIPES_RED_WHITE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.STRIPES_RED_WHITE.DESC"
msgid "It's the merriest storage bin of all."
msgstr "数ある収納庫の中で最も楽しい収納箱です。"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.STRIPES_RED_WHITE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.STRIPES_RED_WHITE.NAME"
msgid "Bold Stripe Storage Bin"
msgstr "ボールドストライプ収納庫"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.YELLOW_TARTAR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.YELLOW_TARTAR.DESC"
msgid "Color-coded storage makes things easier to find."
msgstr "色分けされた収納庫は物を見つけやすくします。"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.YELLOW_TARTAR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.YELLOW_TARTAR.NAME"
msgid "<link=\"STORAGELOCKER\">Ick Yellow Storage Bin</link>"
msgstr "<link=\"STORAGELOCKER\">嫌な黄色の収納庫</link>"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.NAME"
msgid "<link=\"STORAGELOCKER\">Storage Bin</link>"
msgstr "<link=\"STORAGELOCKER\">収納庫</link>"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.DESC"
msgid "Smart storage bins can automate resource organization based on type and mass."
msgstr "スマート収納庫は、種類や質量に応じた資源の整理を自動化できます。"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.EFFECT"
msgid ""
"Stores the <link=\"ELEMENTSSOLID\">Solid Materials</link> of your choosing.\n"
"\n"
"Sends a <b><style=\"logic_on\">Green Signal</style></b> when bin is full."
msgstr ""
"指定した<link=\"ELEMENTSSOLID\">固形素材</link>を収納します。\n"
"\n"
"満杯なら<b><style=\"logic_on\">グリーン</style></b>の信号を送信します。"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.LOGIC_PORT"
msgid "Full/Not Full"
msgstr "満杯 / 空き有り"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when full"
msgstr "満杯なら<b><style=\"logic_on\">グリーン</style></b>を送信"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "それ以外は<b><style=\"logic_off\">レッド</style></b>を送信"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.NAME"
msgid "<link=\"STORAGELOCKERSMART\">Smart Storage Bin</link>"
msgstr "<link=\"STORAGELOCKERSMART\">スマート収納庫</link>"

#. STRINGS.BUILDINGS.PREFABS.STORAGETILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGETILE.DESC"
msgid "Storage tiles keep selected non-edible solids out of the way."
msgstr "収納タイルは指定された食用でない固体をしまっておけます。"

#. STRINGS.BUILDINGS.PREFABS.STORAGETILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGETILE.EFFECT"
msgid ""
"Used to build the walls and floors of rooms.\n"
"\n"
"Provides built-in storage for small spaces."
msgstr ""
"部屋用の壁や床として使えます。\n"
"\n"
"内蔵された収納庫には多少のスペースがあります。"

#. STRINGS.BUILDINGS.PREFABS.STORAGETILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGETILE.NAME"
msgid "<link=\"STORAGETILE\">Storage Tile</link>"
msgstr "<link=\"STORAGETILE\">収納タイル</link>"

# sublime にも他動詞で「昇華」という意味がある
#. STRINGS.BUILDINGS.PREFABS.SUBLIMATIONSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SUBLIMATIONSTATION.DESC"
msgid "Sublimation is the sublime process by which solids convert directly into gas."
msgstr "昇華は、固体が直接ガスに変換される豪華なプロセスです。"

#. STRINGS.BUILDINGS.PREFABS.SUBLIMATIONSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SUBLIMATIONSTATION.EFFECT"
msgid ""
"Speeds up the conversion of <link=\"TOXICSAND\">Polluted Dirt</link> into <link=\"CONTAMINATEDOXYGEN\">Polluted Oxygen</link>.\n"
"\n"
"Becomes idle when the area reaches maximum pressure capacity."
msgstr ""
"<link=\"TOXICSAND\">汚染土</link>を素早く<link=\"CONTAMINATEDOXYGEN\">汚染酸素</link>へ変換させます。\n"
"\n"
"最大気圧に達すると待機状態になります。"

#. STRINGS.BUILDINGS.PREFABS.SUBLIMATIONSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SUBLIMATIONSTATION.NAME"
msgid "<link=\"SUBLIMATIONSTATION\">Sublimation Station</link>"
msgstr "<link=\"SUBLIMATIONSTATION\">昇華端末</link>"

#. STRINGS.BUILDINGS.PREFABS.SUGARENGINE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SUGARENGINE.DESC"
msgid "Not the most stylish way to travel space, but certainly the tastiest."
msgstr "宇宙を旅する方法としてはあまりカッコよくありませんが、一番美味であることは確かです。"

#. STRINGS.BUILDINGS.PREFABS.SUGARENGINE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SUGARENGINE.EFFECT"
msgid ""
"Burns <link=\"SUCROSE\">Sucrose</link> to propel rockets for short range space exploration.\n"
"\n"
"Sugar Engines have higher height restrictions than <link=\"CO2ENGINE\">Carbon Dioxide Engines</link>, but move slower.\n"
"\n"
"Engine must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>, and requires a <link=\"OXIDIZERTANKCLUSTER\">Large Solid Oxidizer Tank</link>. \n"
"\n"
"Once the engine has been built, more rocket modules can be added."
msgstr ""
"<link=\"SUCROSE\">スクロース</link>を燃やし、宇宙探索ロケットの短距離推進力とします。\n"
"\n"
"砂糖エンジンは<link=\"CO2ENGINE\">二酸化炭素エンジン</link>よりもロケット全長制限は緩いですが、その分速度は遅めです。\n"
"\n"
"エンジンは<link=\"LAUNCHPAD\">ロケット発射台</link>経由で建築し、固体酸化剤タンクが必要です。\n"
"\n"
"ロケットのエンジンは他のどのロケットモジュールよりも最初に建築する必要があります。"

#. STRINGS.BUILDINGS.PREFABS.SUGARENGINE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SUGARENGINE.NAME"
msgid "<link=\"SUGARENGINE\">Sugar Engine</link>"
msgstr "<link=\"SUGARENGINE\">砂糖エンジン</link>"

#. STRINGS.BUILDINGS.PREFABS.SUITFABRICATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SUITFABRICATOR.DESC"
msgid "Exosuits can be filled with oxygen to allow Duplicants to safely enter hazardous areas."
msgstr "EXOスーツは住むのに適さないエリアへ入るために酸素を充填することができます。"

#. STRINGS.BUILDINGS.PREFABS.SUITFABRICATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SUITFABRICATOR.EFFECT"
msgid ""
"Forges protective <link=\"EQUIPMENT\">Exosuits</link> for Duplicants to wear.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"複製人間が着用するための防護 <link=\"EQUIPMENT\">EXOスーツ</link>を製造します。\n"
"\n"
"レシピがセットされていないと複製人間は製造作業をしません。"

#. STRINGS.BUILDINGS.PREFABS.SUITFABRICATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SUITFABRICATOR.NAME"
msgid "<link=\"SUITFABRICATOR\">Exosuit Forge</link>"
msgstr "<link=\"SUITFABRICATOR\">EXOスーツ製造所</link>"

#. STRINGS.BUILDINGS.PREFABS.SUITLOCKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SUITLOCKER.DESC"
msgid "An atmo suit dock will empty atmo suits of waste, but only one suit can charge at a time."
msgstr "ドックはアトモスーツに空気を充填したり、廃棄物を空にすることができます。一度に充填できるのは1着のみです。"

#. STRINGS.BUILDINGS.PREFABS.SUITLOCKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SUITLOCKER.EFFECT"
msgid ""
"Stores <link=\"ATMOSUIT\">Atmo Suits</link> and refuels them with <link=\"OXYGEN\">Oxygen</link>.\n"
"\n"
"Empties suits of <link=\"DIRTYWATER\">Polluted Water</link>.\n"
"\n"
"Build next to an <link=\"SUITMARKER\">Atmo Suit Checkpoint</link> to make Duplicants change into suits when passing by."
msgstr ""
"<link=\"ATMOSUIT\">アトモスーツ</link> を格納し、<link=\"OXYGEN\">酸素</link>を充填します。\n"
"\n"
"スーツの<link=\"DIRTYWATER\">汚染水</link>を排出します。\n"
"\n"
"通過する複製人間がスーツを脱着できるよう、<link=\"SUITMARKER\">アトモスーツ脱着所</link>に隣接して設置してください。"

#. STRINGS.BUILDINGS.PREFABS.SUITLOCKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SUITLOCKER.NAME"
msgid "<link=\"SUITLOCKER\">Atmo Suit Dock</link>"
msgstr "<link=\"SUITLOCKER\">アトモスーツ ドック</link>"

#. STRINGS.BUILDINGS.PREFABS.SUITMARKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SUITMARKER.DESC"
msgid "A checkpoint must have a correlating dock built on the opposite side its arrow faces."
msgstr "脱着所は、矢印が指す向きの反対側にドックを併設しなければなりません。"

#. STRINGS.BUILDINGS.PREFABS.SUITMARKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SUITMARKER.EFFECT"
msgid ""
"Marks a threshold where Duplicants must change into or out of <link=\"ATMOSUIT\">Atmo Suits</link>.\n"
"\n"
"Must be built next to an <link=\"SUITLOCKER\">Atmo Suit Dock</link>.\n"
"\n"
"Can be rotated before construction."
msgstr ""
"複製人間に<link=\"ATMOSUIT\">アトモスーツ</link>の脱着を行わせる玄関口として機能します。\n"
"\n"
"<link=\"SUITLOCKER\">アトモスーツ ドック</link>に隣接して設置されていなければなりません。\n"
"\n"
"建築する前に向きを変えることができます。"

#. STRINGS.BUILDINGS.PREFABS.SUITMARKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SUITMARKER.NAME"
msgid "<link=\"SUITMARKER\">Atmo Suit Checkpoint</link>"
msgstr "<link=\"SUITMARKER\">アトモスーツ脱着所</link>"

#. STRINGS.BUILDINGS.PREFABS.SUNLAMP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SUNLAMP.DESC"
msgid "An artificial ray of sunshine."
msgstr "人工的に生み出された日光です。"

#. STRINGS.BUILDINGS.PREFABS.SUNLAMP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SUNLAMP.EFFECT"
msgid ""
"Gives off <link=\"LIGHT\">Sunlight</link> level Lux.\n"
"\n"
"Can be paired with <link=\"BEACHCHAIR\">Beach Chairs</link>."
msgstr ""
"<link=\"LIGHT\">日光</link>レベルの光量を放ちます。\n"
"\n"
"<link=\"BEACHCHAIR\">ビーチチェア</link>とセットにできます。"

#. STRINGS.BUILDINGS.PREFABS.SUNLAMP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SUNLAMP.NAME"
msgid "<link=\"SUNLAMP\">Sun Lamp</link>"
msgstr "<link=\"SUNLAMP\">日光ランプ</link>"

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.DESC"
msgid "Rare materials can be procured through rocket missions into space."
msgstr "希少素材はロケットミッションを通じて手に入れることができます。"

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.EFFECT"
msgid ""
"Processes <link=\"RAREMATERIALS\">Rare Materials</link> into advanced industrial goods.\n"
"\n"
"Rare materials can be retrieved from space missions.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"<link=\"RAREMATERIALS\">希少素材</link>を上位の工業製品に加工します。\n"
"\n"
"希少素材は宇宙ミッションを通じて手に入れることができます。\n"
"\n"
"レシピがセットされていないと複製人間は製作作業をしません。"

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.FULLERENE_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.FULLERENE_RECIPE_DESCRIPTION"
msgid "Fullerene is a <link=\"ELEMENTSSOLID\">Solid Material</link> used in the production of <link=\"SUPERCOOLANT\">Super Coolant</link>."
msgstr "フラーレンは<link=\"SUPERCOOLANT\">超冷却剤</link>を生成するのに役立つ<link=\"ELEMENTSSOLID\">固形素材</link>です。"

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.HARDPLASTIC_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.HARDPLASTIC_RECIPE_DESCRIPTION"
msgid "Plastium is a highly heat-resistant, plastic-like <link=\"ELEMENTSSOLID\">Solid Material</link> used for space buildings."
msgstr "プラスチウムは高い断熱性を持つプラスチック状の<link=\"ELEMENTSSOLID\">固形素材</link>で、宇宙用途の設備に使われます。"

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.NAME"
msgid "<link=\"SUPERMATERIALREFINERY\">Molecular Forge</link>"
msgstr "<link=\"SUPERMATERIALREFINERY\">分子合成機</link>"

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.SELF_CHARGING_POWERBANK_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.SELF_CHARGING_POWERBANK_RECIPE_DESCRIPTION"
msgid "Atomic Power Banks are portable, self-charging units used for isolated <link=\"POWER\">Power</link> grids."
msgstr "原子力 電力バンクは持ち運び可能な、自分自身を充電できる電力ユニットです。隔離された<link=\"POWER\">電力</link>網で使用されます。"

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.SUPERCOOLANT_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.SUPERCOOLANT_RECIPE_DESCRIPTION"
msgid "Super Coolant is an industrial-grade <link=\"FULLERENE\">Fullerene</link> coolant."
msgstr "超冷却剤は産業レベルの<link=\"FULLERENE\">フラーレン</link>冷却剤です。"

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.SUPERINSULATOR_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.SUPERINSULATOR_RECIPE_DESCRIPTION"
msgid "Insulite reduces <link=\"HEAT\">Heat Transfer</link> and is composed of recrystallized <link=\"KATAIRITE\">Abyssalite</link>."
msgstr "インスライトは<link=\"HEAT\">熱交換</link>を低減し、再結晶化した<link=\"KATAIRITE\">アビサライト</link>で構成されています。"

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.TEMPCONDUCTORSOLID_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.TEMPCONDUCTORSOLID_RECIPE_DESCRIPTION"
msgid "Thermium is an industrial metal alloy formulated to maximize <link=\"HEAT\">Heat Transfer</link> and thermal dispersion."
msgstr "テルミウムは<link=\"HEAT\">熱交換</link>を熱分散を最大化させるよう配合された工業用合金です。"

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.VISCOGEL_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.VISCOGEL_RECIPE_DESCRIPTION"
msgid "Visco-Gel Fluid is a <link=\"ELEMENTSLIQUID\">Liquid</link> polymer with high surface tension."
msgstr "ビスコ ゲルは高い表面張力を持った<link=\"ELEMENTSLIQUID\">液体</link>ポリマーです。"

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.YELLOWCAKE_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.YELLOWCAKE_RECIPE_DESCRIPTION"
msgid "Yellowcake is a <link=\"ELEMENTSSOLID\">Solid Material</link> used in uranium enrichment."
msgstr "イエローケーキはウラン濃縮に使われる<link=\"ELEMENTSSOLID\">固形素材</link>です。"

#. STRINGS.BUILDINGS.PREFABS.SUSHIBAR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SUSHIBAR.DESC"
msgid "Expert chefs let the ingredients speak for themselves."
msgstr "熟練のシェフは、食材本来の味を最大限に引き出します。"

#. STRINGS.BUILDINGS.PREFABS.SUSHIBAR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SUSHIBAR.EFFECT"
msgid ""
"Prepares a variety of <link=\"FOOD\">Uncooked Seafood</link>.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"様々な<link=\"FOOD\">生の海産食糧</link>を調理します。\n"
"\n"
"レシピがセットされていないと複製人間は製作作業をしません。"

#. STRINGS.BUILDINGS.PREFABS.SUSHIBAR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SUSHIBAR.NAME"
msgid "<link=\"SUSHIBAR\">Sushi Bar</link>"
msgstr "<link=\"SUSHIBAR\">寿司BAR</link>"

#. STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.DESC"
msgid "The cute little face comes pre-installed."
msgstr "可愛い顔がプレインストール済みです。"

#. STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.EFFECT"
msgid ""
"Deploys an automated <link=\"SWEEPBOT\">Sweepy Bot</link> to sweep up <link=\"ELEMENTSSOLID\">Solid</link> debris and <link=\"ELEMENTSLIQUID\">Liquid</link> spills.\n"
"\n"
"Dock stores <link=\"ELEMENTSLIQUID\">Liquids</link> and <link=\"ELEMENTSSOLID\">Solids</link> gathered by the Sweepy.\n"
"\n"
"Uses <link=\"POWER\">Power</link> to recharge the Sweepy.\n"
"\n"
"Duplicants will empty Dock storage into available storage bins."
msgstr ""
"全自動の<link=\"SWEEPBOT\">スウィーピーボット</link>を派遣して、<link=\"ELEMENTSSOLID\">固体</link>のがれきや零れた<link=\"ELEMENTSLIQUID\">液体</link>を片付けます。\n"
"\n"
"ドックには、スウィーピーが集めた<link=\"ELEMENTSLIQUID\">液体</link>や<link=\"ELEMENTSSOLID\">固形素材</link>が収納されます。\n"
"\n"
"スウィーピーの充電には<link=\"POWER\">電力</link>を使用します。\n"
"\n"
"複製人間はドックを空にして、その中身を収納庫へ移します。"

#. STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.NAME"
msgid "<link=\"SWEEPBOTSTATION\">Sweepy's Dock</link>"
msgstr "<link=\"SWEEPBOTSTATION\">スウィーピー ドック</link>"

#. STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.NAMEDSTATION
msgctxt "STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.NAMEDSTATION"
msgid "{0}'s Dock"
msgstr "{0}のドック"

#. STRINGS.BUILDINGS.PREFABS.SWITCH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.DESC"
msgid "Switches can only affect buildings that come after them on a circuit."
msgstr "スイッチは回路の前にある設備に対しては影響を及ぼしませんが、後ろにある全ての設備を制御します。"

#. STRINGS.BUILDINGS.PREFABS.SWITCH.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.EFFECT"
msgid ""
"Turns <link=\"POWER\">Power</link> on or off.\n"
"\n"
"Does not affect circuitry preceding the switch."
msgstr ""
"<link=\"POWER\">電力</link>のON/OFFを切り替えます。\n"
"\n"
"スイッチの前にある回路には影響を及ぼしません。"

#. STRINGS.BUILDINGS.PREFABS.SWITCH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.NAME"
msgid "<link=\"SWITCH\">Switch</link>"
msgstr "<link=\"SWITCH\">スイッチ</link>"

#. STRINGS.BUILDINGS.PREFABS.SWITCH.SIDESCREEN_TITLE
msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.SIDESCREEN_TITLE"
msgid "Switch"
msgstr "スイッチ"

#. STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_OFF
msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_OFF"
msgid "Turn Off"
msgstr "OFF にする"

#. STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_OFF_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_OFF_TOOLTIP"
msgid "Turn Off {Hotkey}"
msgstr "OFF にする {Hotkey}"

#. STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_ON
msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_ON"
msgid "Turn On"
msgstr "ON にする"

#. STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_ON_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_ON_TOOLTIP"
msgid "Turn On {Hotkey}"
msgstr "ON にする {Hotkey}"

#. STRINGS.BUILDINGS.PREFABS.TELEPHONE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.DESC"
msgid "You never know who you'll meet on the other line."
msgstr "誰に繋がるか分かりません。"

#. STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT"
msgid ""
"Can be used by one Duplicant to chat with themselves or with other Duplicants in different locations.\n"
"\n"
"Chatting increases Duplicant <link=\"MORALE\">Morale</link>."
msgstr ""
"休憩中に複製人間が独り言をつぶやいたり、離れた場所に居る仲間たちとおしゃべりできるようになります。\n"
"\n"
"おしゃべりは複製人間の<link=\"MORALE\">士気</link>を高めます。"

#. STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_BABBLE
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_BABBLE"
msgid "{attrib}: {amount} (No One)"
msgstr "{attrib}: {amount} (誰も居ない)"

#. STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_BABBLE_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_BABBLE_TOOLTIP"
msgid "Duplicants will gain {amount} {attrib} if they chat only with themselves."
msgstr "複製人間がつぶやくと、{amount} {attrib} を獲得します。"

#. STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_CHAT
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_CHAT"
msgid "{attrib}: {amount} (At least one Duplicant)"
msgstr "{attrib}: {amount} (一人以上)"

#. STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_CHAT_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_CHAT_TOOLTIP"
msgid "Duplicants will gain {amount} {attrib} if they chat with at least one other Duplicant."
msgstr "複製人間が他人とおしゃべりすると {amount} {attrib} を獲得します。"

#. STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_LONG_DISTANCE
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_LONG_DISTANCE"
msgid "{attrib}: {amount} (At least one Duplicant across space)"
msgstr "{attrib}: {amount} (宇宙空間を通じて一人以上)"

#. STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_LONG_DISTANCE_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_LONG_DISTANCE_TOOLTIP"
msgid "Duplicants will gain {amount} {attrib} if they chat with at least one other Duplicant across space."
msgstr "複製人間が宇宙を隔てた場所に居る他人とおしゃべりすると {amount} {attrib} を獲得します。"

#. STRINGS.BUILDINGS.PREFABS.TELEPHONE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.NAME"
msgid "<link=\"TELEPHONE\">Party Line Phone</link>"
msgstr "<link=\"TELEPHONE\">共同電話</link>"

#. STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.DESC"
msgid "Duplicants are just atoms as far as the pad's concerned."
msgstr "パッドから見れば、複製人間は原子の寄せ集めです。"

#. STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.EFFECT"
msgid "Instantly transports Duplicants and items to another portal with the same portal code."
msgstr "テレポーターパッドは複製人間やアイテムを同じコードを持ったポータルへ瞬時に移動させます。"

#. STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.LOGIC_PORT"
msgid "Portal Code Input"
msgstr "ポータルコード入力"

#. STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.LOGIC_PORT_ACTIVE"
msgid "1"
msgstr "1"

#. STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.LOGIC_PORT_INACTIVE"
msgid "0"
msgstr "0"

#. STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.NAME"
msgid "Teleporter Pad"
msgstr "テレポーターパッド"

#. STRINGS.BUILDINGS.PREFABS.TELESCOPE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TELESCOPE.DESC"
msgid "Telescopes are necessary for learning starmaps and conducting rocket missions."
msgstr "観測望遠鏡はロケットミッションや星図を作るために必要です。"

#. STRINGS.BUILDINGS.PREFABS.TELESCOPE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TELESCOPE.EFFECT"
msgid ""
"Maps Starmap destinations for space exploration.\n"
"\n"
"Assigned Duplicants must possess the <link=\"RESEARCHING2\">Field Research</link> skill.\n"
"\n"
"Building must be exposed to space to function."
msgstr ""
"星図に目的地をプロットします。\n"
"\n"
"<link=\"RESEARCHING2\">地勢分析</link>スキルを持った複製人間を割り当てる必要があります。\n"
"\n"
"機能するためには宇宙に面している必要があります。"

#. STRINGS.BUILDINGS.PREFABS.TELESCOPE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TELESCOPE.NAME"
msgid "<link=\"TELESCOPE\">Telescope</link>"
msgstr "<link=\"TELESCOPE\">観測望遠鏡</link>"

#. STRINGS.BUILDINGS.PREFABS.TELESCOPE.REQUIREMENT_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.TELESCOPE.REQUIREMENT_TOOLTIP"
msgid "A steady {0} supply is required to sustain working Duplicants."
msgstr "複製人間が働き続けるために、{0}の安定供給が必要です。"

#. STRINGS.BUILDINGS.PREFABS.TEMPERATURECONTROLLEDSWITCH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPERATURECONTROLLEDSWITCH.DESC"
msgid "Automated switches can be used to manage circuits in areas where Duplicants cannot enter."
msgstr "反応スイッチは複製人間が立ち入れない場所の回路を管理するために使われます。"

#. STRINGS.BUILDINGS.PREFABS.TEMPERATURECONTROLLEDSWITCH.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPERATURECONTROLLEDSWITCH.EFFECT"
msgid ""
"Automatically turns <link=\"POWER\">Power</link> on or off using ambient <link=\"HEAT\">Temperature</link>.\n"
"\n"
"Does not affect circuitry preceding the switch."
msgstr ""
"周囲の<link=\"HEAT\">温度</link>に反応し、<link=\"POWER\">電力</link>のON/OFFを自動的に切り替えます。\n"
"\n"
"スイッチの前にある回路には影響を及ぼしません。"

#. STRINGS.BUILDINGS.PREFABS.TEMPERATURECONTROLLEDSWITCH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPERATURECONTROLLEDSWITCH.NAME"
msgid "<link=\"TEMPERATURECONTROLLEDSWITCH\">Thermo Switch</link>"
msgstr "<link=\"TEMPERATURECONTROLLEDSWITCH\">温度スイッチ</link>"

#. STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.DESC"
msgid "Infinite possibilities, with a complimentary side of meteor showers."
msgstr "無限の可能性、おまけに無料の流星群もついてきます。"

#. STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.EFFECT"
msgid "A powerful mechanism capable of tearing through the fabric of reality."
msgstr "現実を切り裂く強力なメカニズムです。"

#. STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.NAME"
msgid "Temporal Tear Opener"
msgstr "時間の裂け目オープナー"

#. STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.SIDESCREEN.TEXT
msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.SIDESCREEN.TEXT"
msgid "Fire!"
msgstr "発射！"

#. STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.SIDESCREEN.TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.SIDESCREEN.TOOLTIP"
msgid "The big red button."
msgstr "赤い大きなボタンです。"

#. STRINGS.BUILDINGS.PREFABS.THERMALBLOCK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.THERMALBLOCK.DESC"
msgid "The thermal properties of construction materials determine their heat retention."
msgstr "建築素材の熱特性が伝熱性に影響します。"

#. STRINGS.BUILDINGS.PREFABS.THERMALBLOCK.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.THERMALBLOCK.EFFECT"
msgid ""
"Accelerates or buffers <link=\"HEAT\">Heat</link> dispersal based on the construction material used.\n"
"\n"
"Has a small area of effect."
msgstr ""
"建築に使われた素材によって<link=\"HEAT\">熱</link>を放熱したり保温したりします。\n"
"\n"
"狭い範囲に効果があります。"

#. STRINGS.BUILDINGS.PREFABS.THERMALBLOCK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.THERMALBLOCK.NAME"
msgid "<link=\"THERMALBLOCK\">Tempshift Plate</link>"
msgstr "<link=\"THERMALBLOCK\">熱交換プレート</link>"

#. STRINGS.BUILDINGS.PREFABS.TILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TILE.DESC"
msgid "Tile can be used to bridge gaps and get to unreachable areas."
msgstr "タイルは部屋や床の建材、新しいエリアへの橋として使われます。"

#. STRINGS.BUILDINGS.PREFABS.TILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TILE.EFFECT"
msgid ""
"Used to build the walls and floors of rooms.\n"
"\n"
"Increases Duplicant runspeed."
msgstr ""
"部屋用の壁や床として使えます。\n"
"\n"
"複製人間の移動速度を上昇させます。"

#. STRINGS.BUILDINGS.PREFABS.TILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TILE.NAME"
msgid "<link=\"TILE\">Tile</link>"
msgstr "<link=\"TILE\">タイル</link>"

#. STRINGS.BUILDINGS.PREFABS.TILEPOI.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TILEPOI.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.TILEPOI.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TILEPOI.EFFECT"
msgid "Used to build the walls and floor of rooms."
msgstr "部屋用の壁や床として使えます。"

#. STRINGS.BUILDINGS.PREFABS.TILEPOI.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TILEPOI.NAME"
msgid "<link=\"TILEPOI\">Tile</link>"
msgstr "<link=\"TILEPOI\">タイル</link>"

#. STRINGS.BUILDINGS.PREFABS.TOURISTMODULE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TOURISTMODULE.DESC"
msgid "An astronaut must accompany sight seeing Duplicants on rocket flights."
msgstr "ロケット航行中、宇宙飛行士は観光客に随伴しなければなりません。"

#. STRINGS.BUILDINGS.PREFABS.TOURISTMODULE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TOURISTMODULE.EFFECT"
msgid ""
"Allows one non-Astronaut Duplicant to visit space.\n"
"\n"
"Sight-Seeing Rocket flights decrease <link=\"STRESS\">Stress</link>."
msgstr ""
"宇宙飛行士でない複製人間が一人搭乗できるスペースを確保します。\n"
"\n"
"観光ロケット航行中は<link=\"STRESS\">ストレス</link>を減少させます。"

#. STRINGS.BUILDINGS.PREFABS.TOURISTMODULE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TOURISTMODULE.NAME"
msgid "<link=\"TOURISTMODULE\">Sight-Seeing Module</link>"
msgstr "<link=\"TOURISTMODULE\">観光モジュール</link>"

#. STRINGS.BUILDINGS.PREFABS.TRAVELTUBE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBE.DESC"
msgid "Duplicants will only exit a transit tube when a safe landing area is available beneath it."
msgstr "安全に着地できる場所が無いと、移動チューブから出られません。"

#. STRINGS.BUILDINGS.PREFABS.TRAVELTUBE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBE.EFFECT"
msgid ""
"Quickly transports Duplicants from a <link=\"TRAVELTUBEENTRANCE\">Transit Tube Access</link> to the tube's end.\n"
"\n"
"Only transports Duplicants."
msgstr ""
"<link=\"TRAVELTUBEENTRANCE\">移動チューブ入口</link>から出口まで、複製人間を素早く輸送します。\n"
"\n"
"輸送できるのは複製人間だけです。"

#. STRINGS.BUILDINGS.PREFABS.TRAVELTUBE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBE.NAME"
msgid "<link=\"TRAVELTUBE\">Transit Tube</link>"
msgstr "<link=\"TRAVELTUBE\">移動チューブ</link>"

#. STRINGS.BUILDINGS.PREFABS.TRAVELTUBEENTRANCE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBEENTRANCE.DESC"
msgid "Duplicants require access points to enter tubes, but not to exit them."
msgstr "入口は複製人間がチューブに入るために必要ですが、チューブから出る場合は不要です。"

#. STRINGS.BUILDINGS.PREFABS.TRAVELTUBEENTRANCE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBEENTRANCE.EFFECT"
msgid ""
"Allows Duplicants to enter the connected <link=\"TRAVELTUBE\">Transit Tube</link> system.\n"
"\n"
"Stops drawing <link=\"POWER\">Power</link> once fully charged."
msgstr ""
"複製人間が接続された<link=\"TRAVELTUBE\">移動チューブ</link>網に入れるようになります。\n"
"\n"
"フル充電されると<link=\"POWER\">電力</link>を消費しなくなります。"

#. STRINGS.BUILDINGS.PREFABS.TRAVELTUBEENTRANCE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBEENTRANCE.NAME"
msgid "<link=\"TRAVELTUBEENTRANCE\">Transit Tube Access</link>"
msgstr "<link=\"TRAVELTUBEENTRANCE\">移動チューブ入口</link>"

#. STRINGS.BUILDINGS.PREFABS.TRAVELTUBEWALLBRIDGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBEWALLBRIDGE.DESC"
msgid "Tube crossings can run transit tubes through walls without leaking gas or liquid."
msgstr "チューブ交差は壁を通して接続でき、気体や液体を漏らすことがありません。"

#. STRINGS.BUILDINGS.PREFABS.TRAVELTUBEWALLBRIDGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBEWALLBRIDGE.EFFECT"
msgid ""
"Allows <link=\"TRAVELTUBE\">Transit Tubes</link> to be run through wall and floor tile.\n"
"\n"
"Functions as regular tile."
msgstr ""
"壁や床のタイルに<link=\"TRAVELTUBE\">移動チューブ</link>を通すことができます。\n"
"\n"
"通常のタイルとしても機能します。"

#. STRINGS.BUILDINGS.PREFABS.TRAVELTUBEWALLBRIDGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBEWALLBRIDGE.NAME"
msgid "<link=\"TRAVELTUBEWALLBRIDGE\">Transit Tube Crossing</link>"
msgstr "<link=\"TRAVELTUBEWALLBRIDGE\">移動チューブ交差</link>"

#. STRINGS.BUILDINGS.PREFABS.UNCONSTRUCTEDROCKETMODULE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.UNCONSTRUCTEDROCKETMODULE.DESC"
msgid "Something useful could be put here someday"
msgstr "そのうち役に立ちそうなものを置いておけます"

#. STRINGS.BUILDINGS.PREFABS.UNCONSTRUCTEDROCKETMODULE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.UNCONSTRUCTEDROCKETMODULE.EFFECT"
msgid "Can be changed into a different rocket module"
msgstr "別のロケットモジュールに変更できます"

#. STRINGS.BUILDINGS.PREFABS.UNCONSTRUCTEDROCKETMODULE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.UNCONSTRUCTEDROCKETMODULE.NAME"
msgid "Empty Rocket Module"
msgstr "空のロケットモジュールです"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERBREATHINGSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERBREATHINGSTATION.DESC"
msgid "Submerged Duplicants recover their breath faster by using a breathing station than by surfacing for air."
msgstr "水中の複製人間は、\t水面に浮上して呼吸するよりも呼吸端末を使った方が早く呼吸を整えることができます。"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERBREATHINGSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERBREATHINGSTATION.EFFECT"
msgid "Provides breathable <link=\"OXYGEN\">Oxygen</link> to Duplicants in suffocating environments via a connected <link=\"GASPIPING\">Gas Pipe</link> input."
msgstr "窒息環境にいる複製人間に、<link=\"GASPIPING\">気体パイプ</link>経由で入力された<link=\"OXYGEN\">酸素</link>を供給します。"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERBREATHINGSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERBREATHINGSTATION.NAME"
msgid "<link=\"UNDERWATERBREATHINGSTATION\">Breathing Station</link>"
msgstr "<link=\"UNDERWATERBREATHINGSTATION\">呼吸端末</link>"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERCRITTERCONDO.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERCRITTERCONDO.DESC"
msgid "Even wild critters are happier after they've had a little R&R."
msgstr "野生動物も休養を取れば幸せになります。"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERCRITTERCONDO.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERCRITTERCONDO.EFFECT"
msgid "A fancy respite area for adult <link=\"CREATURES\">Critters</link> who live in <link=\"ELEMENTSLIQUID\">Liquid</link> pools."
msgstr "<link=\"ELEMENTSLIQUID\">液体</link>プールに生息する成体<link=\"CREATURES\">動物</link>のための豪華な休憩エリアです。"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERCRITTERCONDO.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERCRITTERCONDO.NAME"
msgid "<link=\"UNDERWATERCRITTERCONDO\">Aquatic Critter Condo</link>"
msgstr "<link=\"UNDERWATERCRITTERCONDO\">水中基地</link>"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERMILKFEEDER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERMILKFEEDER.DESC"
msgid "A soothing sip of brackene helps critters put up with crowded quarters."
msgstr "モー乳を一口飲めば、動物たちは狭い住環境にも耐えられます。"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERMILKFEEDER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERMILKFEEDER.EFFECT"
msgid ""
"Dispenses <link=\"MILK\">Brackene</link> to aquatic <link=\"CREATURES\">Critters</link>.\n"
"\n"
"Accessing the fountain significantly improves <link=\"CREATURES\">Critters</link>' moods."
msgstr ""
"さまざまな種類の水棲<link=\"CREATURES\">動物</link>に<link=\"MILK\">モー乳</link>を提供します。\n"
"\n"
"噴水を利用することで、<link=\"CREATURES\">動物</link>の気分は大幅に改善します。"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERMILKFEEDER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERMILKFEEDER.NAME"
msgid "<link=\"UNDERWATERMILKFEEDER\">Aquatic Critter Fountain</link>"
msgstr "<link=\"MILKFEEDER\">水中動物用噴水</link>"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERMILKINGSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERMILKINGSTATION.DESC"
msgid "Collecting a critter's unfertilized eggs may slow down their reproduction."
msgstr "動物の未受精卵を採取すると繁殖速度に影響を及ぼす可能性があります。"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERMILKINGSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERMILKINGSTATION.EFFECT"
msgid ""
"Extracts <link=\"FISHMILK\">Ovolene</link> or <link=\"INK\">Squid Ink</link> from eligible aquatic <link=\"CREATURES\">Critters</link>.\n"
"\n"
"Assigned Duplicants must possess both the <link=\"RANCHING2\">Critter Ranching II</link> and <link=\"SWIMMING\">Basic Swimming</link> skills."
msgstr ""
"対象となる水棲動物から<link=\"FISHMILK\">オボレン</link>や<link=\"INK\">イカスミ</link>を抽出します。\n"
"\n"
"<link=\"RANCHING2\">畜産 II</link>スキルおよび<link=\"SWIMMING\">初歩の水泳</link>を習得した複製人間を作業に従事させる必要があります。"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERMILKINGSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERMILKINGSTATION.NAME"
msgid "<link=\"UNDERWATERMILKINGSTATION\">Aquatic Milking Station</link>"
msgstr "<link=\"UNDERWATERMILKINGSTATION\">水中搾乳端末</link>"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERRANCHSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERRANCHSTATION.DESC"
msgid "A groomed critter is a happy, healthy, productive critter."
msgstr "手入れの行き届いた動物は、幸せで健康で生産的な動物です。"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERRANCHSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERRANCHSTATION.EFFECT"
msgid ""
"Allows the assigned <link=\"RANCHER\">Rancher</link> to care for and gradually tame <link=\"CREATURES\">Critters</link>.\n"
"\n"
"Assigned Duplicants must possess both the <link=\"RANCHING1\">Critter Ranching</link> and <link=\"SWIMMING\">Basic Swimming</link> skills."
msgstr ""
"<link=\"RANCHER\">飼育員</link>が<link=\"CREATURES\">動物</link>の世話をできるようにします。\n"
"\n"
"<link=\"RANCHING1\">畜産 I</link>スキルおよび<link=\"SWIMMING\">初歩の水泳</link>を習得した複製人間を作業に従事させる必要があります。"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERRANCHSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERRANCHSTATION.NAME"
msgid "<link=\"UNDERWATERRANCHSTATION\">Aquatic Grooming Station</link>"
msgstr "<link=\"UNDERWATERRANCHSTATION\">水中毛づくろい端末</link>"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERSHEARINGSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERSHEARINGSTATION.DESC"
msgid "Visiting this building restores critters' physical and emotional well-being."
msgstr "この設備に立ち寄ることで、動物たちの身体的・精神的な健康が回復します。"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERSHEARINGSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERSHEARINGSTATION.EFFECT"
msgid ""
"Allows eligible aquatic <link=\"CREATURES\">Critters</link> to be safely sheared for useful raw materials.\n"
"\n"
"Assigned Duplicants must possess both the <link=\"RANCHING1\">Critter Ranching</link> and <link=\"SWIMMING\">Basic Swimming</link> skills."
msgstr ""
"対象となる水棲<link=\"CREATURES\">動物</link>から安全に刈り取って有用な資源を得ることができます。\n"
"\n"
"<link=\"RANCHING1\">畜産 I</link>スキルおよび<link=\"SWIMMING\">初歩の水泳</link>を習得した複製人間を作業に従事させる必要があります。"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERSHEARINGSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERSHEARINGSTATION.NAME"
msgid "<link=\"UNDERWATERSHEARINGSTATION\">Aquatic Shearing Station</link>"
msgstr "<link=\"UNDERWATERSHEARINGSTATION\">水中毛刈り端末</link>"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERVENTDRILL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERVENTDRILL.DESC"
msgid "Once it's all set up, blockages take care of themselves."
msgstr "一度設定してしまえば、詰まりは自動的に解消されます。"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERVENTDRILL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERVENTDRILL.EFFECT"
msgid ""
"Removes mineral build-up from underwater vents to restore the flow of <link=\"ELEMENTSGAS\">Gases</link>.\n"
"\n"
"Must be built on top of a vent or fissure."
msgstr ""
"海底噴出孔に堆積した鉱物を除去し、<link=\"ELEMENTSGAS\">気体</link>の流れを回復させます。\n"
"\n"
"噴出孔または亀裂の上に設置する必要があります。"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERVENTDRILL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERVENTDRILL.NAME"
msgid "<link=\"UNDERWATERVENTDRILL\">Marine Drill</link>"
msgstr "<link=\"UNDERWATERVENTDRILL\">水中ドリル</link>"

#. STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.DESC"
msgid "Enriched uranium is a specialized substance that can be used to fuel powerful research reactors."
msgstr "濃縮ウランは強力な研究炉の燃料として使われる特殊素材です。"

#. STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.EFFECT"
msgid ""
"Extracts <link=\"ENRICHEDURANIUM\">Enriched Uranium</link> from <link=\"URANIUMORE\">Uranium Ore</link>.\n"
"\n"
"Outputs <link=\"DEPLETEDURANIUM\">Depleted Uranium</link> in molten form."
msgstr ""
"<link=\"URANIUMORE\">ウラン鉱石</link>から<link=\"ENRICHEDURANIUM\">濃縮ウラン</link>を抽出します。\n"
"\n"
"溶融した<link=\"DEPLETEDURANIUM\">劣化ウラン</link>を出力します。"

#. STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.NAME"
msgid "<link=\"URANIUMCENTRIFUGE\">Uranium Centrifuge</link>"
msgstr "<link=\"URANIUMCENTRIFUGE\">ウラン遠心分離機</link>"

#. STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.RECIPE_DESCRIPTION"
msgid "Convert Uranium ore to Molten Uranium and Enriched Uranium"
msgstr "ウラン鉱石を溶融ウランと濃縮ウランに変換します"

#. STRINGS.BUILDINGS.PREFABS.VENDINGMACHINE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.VENDINGMACHINE.DESC"
msgid "A pristine <link=\"FIELDRATION\">Nutrient Bar</link> dispenser."
msgstr "新鮮な<link=\"FIELDRATION\">栄養バー</link>の販売機です。"

#. STRINGS.BUILDINGS.PREFABS.VENDINGMACHINE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.VENDINGMACHINE.NAME"
msgid "Vending Machine"
msgstr "自動販売機"

#. STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.DESC"
msgid "Duplicants love the feeling of high-powered wind through their hair."
msgstr "高出力の風が髪を梳かすことを複製人間は好みます。"

#. STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.DISPLACEMENTEFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.DISPLACEMENTEFFECT"
msgid "Gas Displacement: {amount}"
msgstr "気体排気量: {amount}"

#. STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.DISPLACEMENTEFFECT_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.DISPLACEMENTEFFECT_TOOLTIP"
msgid "This building will displace {amount} Gas while in use."
msgstr "この設備の使用中は{amount}の気体を排気します。"

#. STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.EFFECT"
msgid ""
"Must be connected to a <link=\"POWER\">Power Source</link>. To properly function, the area under this building must be left vacant.\n"
"\n"
"Increases Duplicants <link=\"MORALE\">Morale</link>."
msgstr ""
"<link=\"POWER\">電源</link>が接続されている必要があります。機能させるためには、この設備の真下を空けた状態にしてください。\n"
"\n"
"複製人間の<link=\"MORALE\">士気</link>を高めます。"

#. STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.NAME"
msgid "<link=\"VERTICALWINDTUNNEL\">Vertical Wind Tunnel</link>"
msgstr "<link=\"VERTICALWINDTUNNEL\">インドアスカイダイビング</link>"

#. STRINGS.BUILDINGS.PREFABS.WALLTOILET.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WALLTOILET.DESC"
msgid "Wall Toilets transmit fewer germs to Duplicants and require no emptying."
msgstr "壁掛けトイレは複製人間に付着する病原菌が少なく、汲み取りも必要ありません。"

#. STRINGS.BUILDINGS.PREFABS.WALLTOILET.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WALLTOILET.EFFECT"
msgid ""
"Gives Duplicants a place to relieve themselves. Empties directly on the other side of the wall.\n"
"\n"
"Spreads very few <link=\"DISEASE\">Germs</link>."
msgstr ""
"複製人間に用を足す場所を提供します。壁の反対側に直接排出します。\n"
"\n"
"<link=\"DISEASE\">病原菌</link>は殆ど出ません。"

#. STRINGS.BUILDINGS.PREFABS.WALLTOILET.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WALLTOILET.NAME"
msgid "<link=\"WALLTOILET\">Wall Toilet</link>"
msgstr "<link=\"WALLTOILET\">壁掛けトイレ</link>"

#. STRINGS.BUILDINGS.PREFABS.WARPCONDUITRECEIVER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPCONDUITRECEIVER.DESC"
msgid "The tubes at the back disappear into nowhere."
msgstr "チューブの奥はどこかへと消えています。"

#. STRINGS.BUILDINGS.PREFABS.WARPCONDUITRECEIVER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPCONDUITRECEIVER.EFFECT"
msgid ""
"A machine capable of teleporting <link=\"ELEMENTSLIQUID\">Liquid</link>, <link=\"ELEMENTSSOLID\">Solid</link>, and <link=\"ELEMENTSGAS\">Gas</link> resources to another asteroid.\n"
"\n"
"It can be activated by a Duplicant with the <link=\"RESEARCHING2\">Field Research</link> skill.\n"
"\n"
"This is the receiving side."
msgstr ""
"他の小惑星から<link=\"ELEMENTSLIQUID\">液体</link>、<link=\"ELEMENTSSOLID\">固体</link>、<link=\"ELEMENTSGAS\">気体</link>資源をテレポートできる機械です。\n"
"\n"
"<link=\"RESEARCHING2\">実地調査</link>スキルを持った複製人間が起動できます。\n"
"\n"
"これは受信側です。"

#. STRINGS.BUILDINGS.PREFABS.WARPCONDUITRECEIVER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPCONDUITRECEIVER.NAME"
msgid "<link=\"WARPCONDUITRECEIVER\">Supply Teleporter Output</link>"
msgstr "<link=\"WARPCONDUITRECEIVER\">補給品テレポーター出口</link>"

#. STRINGS.BUILDINGS.PREFABS.WARPCONDUITSENDER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPCONDUITSENDER.DESC"
msgid "The tubes at the back disappear into nowhere."
msgstr "チューブの奥はどこかへと消えています。"

#. STRINGS.BUILDINGS.PREFABS.WARPCONDUITSENDER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPCONDUITSENDER.EFFECT"
msgid ""
"A machine capable of teleporting <link=\"ELEMENTSLIQUID\">Liquid</link>, <link=\"ELEMENTSSOLID\">Solid</link>, and <link=\"ELEMENTSGAS\">Gas</link> resources to another asteroid.\n"
"\n"
"It can be activated by a Duplicant with the <link=\"RESEARCHING2\">Field Research</link> skill.\n"
"\n"
"This is the transmitting side."
msgstr ""
"他の小惑星から<link=\"ELEMENTSLIQUID\">液体</link>、<link=\"ELEMENTSSOLID\">固体</link>、<link=\"ELEMENTSGAS\">気体</link>資源をテレポートできる機械です。\n"
"\n"
"<link=\"RESEARCHING2\">実地調査</link>スキルを持った複製人間が起動できます。\n"
"\n"
"これは送信側です。"

#. STRINGS.BUILDINGS.PREFABS.WARPCONDUITSENDER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPCONDUITSENDER.NAME"
msgid "<link=\"WARPCONDUITSENDER\">Supply Teleporter Input</link>"
msgstr "<link=\"WARPCONDUITSENDER\">補給品テレポーター入口</link>"

#. STRINGS.BUILDINGS.PREFABS.WARPPORTAL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPPORTAL.DESC"
msgid ""
"The functional remnants of an intricate teleportation system.\n"
"\n"
"This is the outgoing side, and has one pre-programmed destination."
msgstr ""
"複雑なテレポーテーションシステムの残骸です。\n"
"\n"
"これは発信側であり、事前にプログラムされた行先が1つあります。"

#. STRINGS.BUILDINGS.PREFABS.WARPPORTAL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPPORTAL.NAME"
msgid "Teleporter Transmitter"
msgstr "テレポーター送信機"

#. STRINGS.BUILDINGS.PREFABS.WARPRECEIVER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPRECEIVER.DESC"
msgid ""
"The functional remnants of an intricate teleportation system.\n"
"\n"
"This is the incoming side."
msgstr ""
"複雑なテレポーテーションシステムの残骸です。\n"
"\n"
"これは受信側です。"

#. STRINGS.BUILDINGS.PREFABS.WARPRECEIVER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPRECEIVER.NAME"
msgid "Teleporter Receiver"
msgstr "テレポーター受信機"

#. STRINGS.BUILDINGS.PREFABS.WASHBASIN.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHBASIN.DESC"
msgid "Germ spread can be reduced by building these where Duplicants often get dirty."
msgstr "複製人間が汚れそうな場所に設置することで、病原菌の拡大を抑えることができます。"

#. STRINGS.BUILDINGS.PREFABS.WASHBASIN.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHBASIN.EFFECT"
msgid ""
"Removes some <link=\"DISEASE\">Germs</link> from Duplicants.\n"
"\n"
"Germ-covered Duplicants use Wash Basins when passing by in the selected direction."
msgstr ""
"複製人間から<link=\"DISEASE\">病原菌</link>を除去します。\n"
"\n"
"指定された方向へ通過する際、病原菌に覆われた複製人間は洗面台を使用します。"

#. STRINGS.BUILDINGS.PREFABS.WASHBASIN.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHBASIN.NAME"
msgid "<link=\"WASHBASIN\">Wash Basin</link>"
msgstr "<link=\"WASHBASIN\">洗面台</link>"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.DESC"
msgid "Sinks are plumbed and do not need to be manually emptied or refilled."
msgstr "流し台は配管されているため、手動で汲み取りや補充をする必要がありません。"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.EFFECT"
msgid ""
"Removes <link=\"DISEASE\">Germs</link> from Duplicants.\n"
"\n"
"Germ-covered Duplicants use Sinks when passing by in the selected direction."
msgstr ""
"複製人間から<link=\"DISEASE\">病原菌</link>を除去します。\n"
"\n"
"指定された方向へ通過する際、病原菌に覆われた複製人間は流し台を使用します。"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.BLUE_BABYTEARS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.BLUE_BABYTEARS.DESC"
msgid "A calm, colorful sink for heavy-hearted Duplicants."
msgstr "憂鬱な複製人間のための落ち着いた色彩の流し台です。"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.BLUE_BABYTEARS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.BLUE_BABYTEARS.NAME"
msgid "<link=\"WASHSINK\">Weepy Blue Sink</link>"
msgstr "<link=\"WASHSINK\">ウィーピーブルー 流し台</link>"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.DEFAULT_WASHSINK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.DEFAULT_WASHSINK.DESC"
msgid "Sinks are plumbed and do not need to be manually emptied or refilled."
msgstr "流し台は配管されているため、手動で汲み取りや補充をする必要がありません。"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.DEFAULT_WASHSINK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.DEFAULT_WASHSINK.NAME"
msgid "<link=\"WASHSINK\">Sink</link>"
msgstr "<link=\"WASHSINK\">流し台</link>"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.GREEN_MUSH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.GREEN_MUSH.DESC"
msgid "Even the soap is mush-colored."
msgstr "石鹸もマッシュ色をしています。"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.GREEN_MUSH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.GREEN_MUSH.NAME"
msgid "<link=\"WASHSINK\">Mush Green Sink</link>"
msgstr "<link=\"WASHSINK\">マッシュグリーン 流し台</link>"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.PURPLE_BRAINFAT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.PURPLE_BRAINFAT.DESC"
msgid "A refreshing splash of color for the light-headed."
msgstr "頭がくらくらする人向けの爽快な水飛沫です。"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.PURPLE_BRAINFAT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.PURPLE_BRAINFAT.NAME"
msgid "<link=\"WASHSINK\">Faint Purple Sink</link>"
msgstr "<link=\"WASHSINK\">フェイントパープル 流し台</link>"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.RED_ROSE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.RED_ROSE.DESC"
msgid "Some Duplicants say it looks like a germ-devouring mouth."
msgstr "複製人間の中にはこれを「病原菌を貪り食らう口」のようだという者もいます。"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.RED_ROSE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.RED_ROSE.NAME"
msgid "<link=\"WASHSINK\">Puce Pink Sink</link>"
msgstr "<link=\"WASHSINK\">ピュースピンク 流し台</link>"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.YELLOW_TARTAR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.YELLOW_TARTAR.DESC"
msgid "The juxtaposition of 'ick' and 'clean' can be very satisfying."
msgstr "「悪い」と「きれいな」の並置は非常に満足のいくものになる可能性があります。"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.YELLOW_TARTAR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.YELLOW_TARTAR.NAME"
msgid "<link=\"WASHSINK\">Ick Yellow Sink</link>"
msgstr "<link=\"WASHSINK\">イックイエロー 流し台</link>"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.NAME"
msgid "<link=\"WASHSINK\">Sink</link>"
msgstr "<link=\"WASHSINK\">流し台</link>"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.DESC"
msgid "Chatting with friends improves Duplicants' moods and reduces their stress."
msgstr "友人との雑談は複製人間の気分を改善し、ストレスを軽減します。"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.EFFECT"
msgid ""
"Provides a gathering place for Duplicants during Downtime.\n"
"\n"
"Improves Duplicant <link=\"MORALE\">Morale</link> and relieves <link=\"IDFOODEFFECTS\">Thirst</link>."
msgstr ""
"休憩中に複製人間の集まる場所を提供します。\n"
"\n"
"複製人間の<link=\"MORALE\">士気</link>を高め<link=\"IDFOODEFFECTS\">渇き</link>を癒します。"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.BALLOON.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.BALLOON.DESC"
msgid "There's a funny aftertaste."
msgstr "後味が面白いです。"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.BALLOON.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.BALLOON.NAME"
msgid "<link=\"WATERCOOLER\">Inflatable Water Cooler</link>"
msgstr "<link=\"WATERCOOLER\">空気注入式 ウォータークーラー</link>"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.BLUE_BABYTEARS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.BLUE_BABYTEARS.DESC"
msgid "Lightly salted with Duplicants' tears."
msgstr "複製人間の涙で軽く塩味が付いています。"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.BLUE_BABYTEARS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.BLUE_BABYTEARS.NAME"
msgid "<link=\"WATERCOOLER\">Weepy Blue Water Cooler</link>"
msgstr "<link=\"WATERCOOLER\">ウィーピーブルー ウォータークーラー</link>"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.DEFAULT_WATERCOOLER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.DEFAULT_WATERCOOLER.DESC"
msgid "Where Duplicants sip and socialize."
msgstr "複製人間が飲み交わす場所です。"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.DEFAULT_WATERCOOLER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.DEFAULT_WATERCOOLER.NAME"
msgid "<link=\"WATERCOOLER\">Water Cooler</link>"
msgstr "<link=\"WATERCOOLER\">ウォータークーラー</link>"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.GREEN_MUSH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.GREEN_MUSH.DESC"
msgid "Ideal for post-Mush Bar palate cleansing."
msgstr "マッシュバーを食べた後の口直しに最適です。"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.GREEN_MUSH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.GREEN_MUSH.NAME"
msgid "<link=\"WATERCOOLER\">Mush Green Water Cooler</link>"
msgstr "<link=\"WATERCOOLER\">マッシュグリーン ウォータークーラー</link>"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.PURPLE_BRAINFAT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.PURPLE_BRAINFAT.DESC"
msgid "Most Duplicants agree that it really should dispense juice."
msgstr "ジュースが出てくるべきであるということについては殆どの複製人間が同意するところです。"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.PURPLE_BRAINFAT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.PURPLE_BRAINFAT.NAME"
msgid "<link=\"WATERCOOLER\">Faint Purple Water Cooler</link>"
msgstr "<link=\"WATERCOOLER\">フェイントパープル ウォータークーラー</link>"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.RED_ROSE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.RED_ROSE.DESC"
msgid "Rose-colored paper cups: the shatter-proof alternative to rose-colored glasses."
msgstr "バラ色の紙コップは、バラ色ガラスの飛散防止用代替品です。"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.RED_ROSE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.RED_ROSE.NAME"
msgid "<link=\"WATERCOOLER\">Puce Pink Water Cooler</link>"
msgstr "<link=\"WATERCOOLER\">ピュースピンク ウォータークーラー</link>"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.ROUND_BODY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.ROUND_BODY.DESC"
msgid "It really classes up a breakroom."
msgstr "休憩室をとても華やかにします。"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.ROUND_BODY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.ROUND_BODY.NAME"
msgid "<link=\"WATERCOOLER\">Elegant Water Cooler</link>"
msgstr "<link=\"WATERCOOLER\">エレガント ウォータークーラー</link>"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.YELLOW_TARTAR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.YELLOW_TARTAR.DESC"
msgid "Did someone boil eggs in this water?"
msgstr "だれかこの水でゆで卵を作りませんでしたか？"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.YELLOW_TARTAR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.FACADES.YELLOW_TARTAR.NAME"
msgid "<link=\"WATERCOOLER\">Ick Yellow Water Cooler</link>"
msgstr "<link=\"WATERCOOLER\">イックイエロー ウォータークーラー</link>"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.NAME"
msgid "<link=\"WATERCOOLER\">Water Cooler</link>"
msgstr "<link=\"WATERCOOLER\">ウォータークーラー</link>"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.OPTION_TOOLTIPS.INK
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.OPTION_TOOLTIPS.INK"
msgid ""
"<link=\"INK\">Squid Ink</link>\n"
"A thick, dark elixir"
msgstr ""
"<link=\"INK\">イカスミ</link>\n"
"真っ黒なエリクサー"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.OPTION_TOOLTIPS.MILK
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.OPTION_TOOLTIPS.MILK"
msgid ""
"<link=\"MILK\">Brackene</link>\n"
"A salty, green-hued beverage"
msgstr ""
"<link=\"MILK\">モー乳</link>\n"
"塩味の、緑掛かった飲料です"

#. STRINGS.BUILDINGS.PREFABS.WATERCOOLER.OPTION_TOOLTIPS.WATER
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERCOOLER.OPTION_TOOLTIPS.WATER"
msgid ""
"<link=\"WATER\">Water</link>\n"
"Plain potable water"
msgstr ""
"<link=\"WATER\">水</link>\n"
"普通の飲料水です"

#. STRINGS.BUILDINGS.PREFABS.WATERPURIFIER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERPURIFIER.DESC"
msgid "Sieves cannot kill germs and pass any they receive into their waste and water output."
msgstr "浄水機は病原菌を殺菌できません。汚染物質は出力にそのまま流します。"

#. STRINGS.BUILDINGS.PREFABS.WATERPURIFIER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERPURIFIER.EFFECT"
msgid ""
"Produces clean <link=\"WATER\">Water</link> from <link=\"DIRTYWATER\">Polluted Water</link> using <link=\"SAND\">Sand</link>.\n"
"\n"
"Produces <link=\"TOXICSAND\">Polluted Dirt</link>."
msgstr ""
"<link=\"DIRTYWATER\">汚染水</link>を、<link=\"SAND\">砂</link>を使って<link=\"WATER\">水</link>にします。\n"
"\n"
"<link=\"TOXICSAND\">汚染土</link>を生産します。"

#. STRINGS.BUILDINGS.PREFABS.WATERPURIFIER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERPURIFIER.NAME"
msgid "<link=\"WATERPURIFIER\">Water Sieve</link>"
msgstr "<link=\"WATERPURIFIER\">浄水機</link>"

#. STRINGS.BUILDINGS.PREFABS.WATERTRAP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERTRAP.DESC"
msgid "Trapped fish will automatically be bagged for transport."
msgstr "捕獲した魚は持ち運びのため自動的に袋詰めされます。"

#. STRINGS.BUILDINGS.PREFABS.WATERTRAP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERTRAP.EFFECT"
msgid ""
"Attracts and traps aquatic <link=\"CREATURES\">Critters</link>.\n"
"\n"
"Only Duplicants with the <link=\"RANCHING1\">Critter Ranching I</link> skill can arm this trap. It's reusable!"
msgstr ""
"水棲<link=\"CREATURES\">動物</link>をおびき寄せ、捕獲します。\n"
"\n"
"この罠を準備できるのは、<link=\"RANCHING1\">畜産 I</link>スキルを習得済みの複製人間だけです。再利用可能！"

#. STRINGS.BUILDINGS.PREFABS.WATERTRAP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WATERTRAP.NAME"
msgid "<link=\"WATERTRAP\">Fish Trap</link>"
msgstr "<link=\"WATERTRAP\">魚捕獲罠</link>"

#. STRINGS.BUILDINGS.PREFABS.WIDEFARMTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WIDEFARMTILE.DESC"
msgid "Enables Duplicants to accelerate growth rates for oversized plants too."
msgstr "複製人間が巨大植物の成長を促進させることを可能にします。"

#. STRINGS.BUILDINGS.PREFABS.WIDEFARMTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WIDEFARMTILE.EFFECT"
msgid ""
"Grows one extra-large <link=\"PLANTS\">Plant</link> from a <link=\"PLANTS\">Seed</link>.\n"
"\n"
"Can be used as floor tile.\n"
"\n"
"Some plants must be irrigated through <link=\"LIQUIDPIPING\">Liquid Piping</link>."
msgstr ""
"<link=\"PLANTS\">種子</link>から特大サイズの<link=\"PLANTS\">植物</link>を育てることができます。\n"
"\n"
"床材としても使用でき、建築する前に向きを変えることができます。\n"
"\n"
"<link=\"LIQUIDPIPING\">液体パイプ</link>による灌漑が必要です。"

# 農耕タイルの対になるように訳語を変更
#. STRINGS.BUILDINGS.PREFABS.WIDEFARMTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WIDEFARMTILE.NAME"
msgid "<link=\"WIDEFARMTILE\">Wide Hydroponic Farm</link>"
msgstr "<link=\"WIDEFARMTILE\">大型水耕タイル</link>"

#. STRINGS.BUILDINGS.PREFABS.WIRE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WIRE.DESC"
msgid "Electrical wire is used to connect generators, batteries, and buildings."
msgstr "電線は発電機やバッテリー、設備を接続するために使われます。"

#. STRINGS.BUILDINGS.PREFABS.WIRE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WIRE.EFFECT"
msgid ""
"Connects buildings to <link=\"POWER\">Power</link> sources.\n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"<link=\"POWER\">電力</link>源と設備を接続します。\n"
"\n"
"壁タイルや床タイルの中を通すことができます。"

#. STRINGS.BUILDINGS.PREFABS.WIRE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WIRE.NAME"
msgid "<link=\"WIRE\">Wire</link>"
msgstr "<link=\"WIRE\">電線</link>"

#. STRINGS.BUILDINGS.PREFABS.WIREBRIDGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WIREBRIDGE.DESC"
msgid "Splitting generators onto separate grids can prevent overloads and wasted electricity."
msgstr "発電機の出力を複数の回路に分散させることで、過負荷や無駄な電力を防止できます。"

#. STRINGS.BUILDINGS.PREFABS.WIREBRIDGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WIREBRIDGE.EFFECT"
msgid ""
"Runs one wire section over another without joining them.\n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"回路を他と合流させずに、電線をまたいで回路を構成します。\n"
"\n"
"壁タイルや床タイルの中を通すことができます。"

#. STRINGS.BUILDINGS.PREFABS.WIREBRIDGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WIREBRIDGE.NAME"
msgid "<link=\"WIREBRIDGE\">Wire Bridge</link>"
msgstr "<link=\"WIREBRIDGE\">電線ブリッジ</link>"

#. STRINGS.BUILDINGS.PREFABS.WIREBRIDGEHIGHWATTAGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WIREBRIDGEHIGHWATTAGE.DESC"
msgid "Joint plates can run Heavi-Watt wires through walls without leaking gas or liquid."
msgstr "継ぎ板は大容量電線を壁を通して接続でき、気体や液体を漏らすことがありません。"

#. STRINGS.BUILDINGS.PREFABS.WIREBRIDGEHIGHWATTAGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WIREBRIDGEHIGHWATTAGE.EFFECT"
msgid ""
"Allows <link=\"HIGHWATTAGEWIRE\">Heavi-Watt Wire</link> to be run through wall and floor tile.\n"
"\n"
"Functions as regular tile."
msgstr ""
"壁や床のタイルに<link=\"HIGHWATTAGEWIRE\">大容量電線</link>を通すことができます。\n"
"\n"
"通常のタイルとしても機能します。"

#. STRINGS.BUILDINGS.PREFABS.WIREBRIDGEHIGHWATTAGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WIREBRIDGEHIGHWATTAGE.NAME"
msgid "<link=\"WIREBRIDGEHIGHWATTAGE\">Heavi-Watt Joint Plate</link>"
msgstr "<link=\"WIREBRIDGEHIGHWATTAGE\">大容量継ぎ板</link>"

#. STRINGS.BUILDINGS.PREFABS.WIREREFINED.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WIREREFINED.DESC"
msgid "My Duplicants prefer the look of conductive wire to the regular raggedy stuff."
msgstr "複製人間は見た目について言えば通常の電線より導電線のほうが好みです。"

#. STRINGS.BUILDINGS.PREFABS.WIREREFINED.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WIREREFINED.EFFECT"
msgid ""
"Connects buildings to <link=\"POWER\">Power</link> sources.\n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"<link=\"POWER\">電力</link>源と設備を接続します。\n"
"\n"
"壁タイルや床タイルの中を通すことができます。"

#. STRINGS.BUILDINGS.PREFABS.WIREREFINED.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WIREREFINED.NAME"
msgid "<link=\"WIREREFINED\">Conductive Wire</link>"
msgstr "<link=\"WIREREFINED\">導電線</link>"

#. STRINGS.BUILDINGS.PREFABS.WIREREFINEDBRIDGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WIREREFINEDBRIDGE.DESC"
msgid "Splitting generators onto separate systems can prevent overloads and wasted electricity."
msgstr "発電機の出力を複数の回路に分散させることで、過負荷や無駄な電力を防止できます。"

#. STRINGS.BUILDINGS.PREFABS.WIREREFINEDBRIDGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WIREREFINEDBRIDGE.EFFECT"
msgid ""
"Carries more <link=\"POWER\">Wattage</link> than a regular <link=\"WIREBRIDGE\">Wire Bridge</link> without overloading.\n"
"\n"
"Runs one wire section over another without joining them.\n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"通常の<link=\"WIREBRIDGE\">電線ブリッジ</link>より大きな<link=\"POWER\">ワット数</link>を過負荷を起こさずに扱えます。\n"
"\n"
"回路を他と合流させずに、電線をまたいで回路を構成します。\n"
"\n"
"壁タイルや床タイルの中を通すことができます。"

#. STRINGS.BUILDINGS.PREFABS.WIREREFINEDBRIDGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WIREREFINEDBRIDGE.NAME"
msgid "<link=\"WIREREFINEDBRIDGE\">Conductive Wire Bridge</link>"
msgstr "<link=\"WIREREFINEDBRIDGE\">導電線ブリッジ</link>"

#. STRINGS.BUILDINGS.PREFABS.WIREREFINEDBRIDGEHIGHWATTAGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WIREREFINEDBRIDGEHIGHWATTAGE.DESC"
msgid "Joint plates can run Heavi-Watt wires through walls without leaking gas or liquid."
msgstr "継ぎ板は大容量電線を壁を通して接続でき、気体や液体を漏らすことがありません。"

#. STRINGS.BUILDINGS.PREFABS.WIREREFINEDBRIDGEHIGHWATTAGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WIREREFINEDBRIDGEHIGHWATTAGE.EFFECT"
msgid ""
"Carries more <link=\"POWER\">Wattage</link> than a regular <link=\"WIREBRIDGEHIGHWATTAGE\">Heavi-Watt Joint Plate</link> without overloading.\n"
"\n"
"Allows <link=\"HIGHWATTAGEWIRE\">Heavi-Watt Wire</link> to be run through wall and floor tile."
msgstr ""
"通常の<link=\"WIREBRIDGEHIGHWATTAGE\">大容量継ぎ板</link>より大きな<link=\"POWER\">ワット数</link>を過負荷を起こさずに扱えます。\n"
"\n"
"床や壁に<link=\"HIGHWATTAGEWIRE\">大容量電線</link>を通すことができます。"

#. STRINGS.BUILDINGS.PREFABS.WIREREFINEDBRIDGEHIGHWATTAGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WIREREFINEDBRIDGEHIGHWATTAGE.NAME"
msgid "<link=\"WIREREFINEDBRIDGEHIGHWATTAGE\">Heavi-Watt Conductive Joint Plate</link>"
msgstr "<link=\"WIREREFINEDBRIDGEHIGHWATTAGE\">大容量導電線継ぎ板</link>"

#. STRINGS.BUILDINGS.PREFABS.WIREREFINEDHIGHWATTAGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WIREREFINEDHIGHWATTAGE.DESC"
msgid "Higher wattage wire is used to avoid power overloads, particularly for strong generators."
msgstr "大容量電線は強力な発電機による電力の過負荷を避けるために使われます。"

#. STRINGS.BUILDINGS.PREFABS.WIREREFINEDHIGHWATTAGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WIREREFINEDHIGHWATTAGE.EFFECT"
msgid ""
"Carries more <link=\"POWER\">Wattage</link> than regular <link=\"WIRE\">Wire</link> without overloading.\n"
"\n"
"Cannot be run through wall and floor tile."
msgstr ""
"通常の<link=\"WIRE\">電線</link>より大きな<link=\"POWER\">ワット数</link>を、過負荷を起こさずに扱えます。\n"
"\n"
"壁や床のタイル中に敷設することができません。"

#. STRINGS.BUILDINGS.PREFABS.WIREREFINEDHIGHWATTAGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WIREREFINEDHIGHWATTAGE.NAME"
msgid "<link=\"WIREREFINEDHIGHWATTAGE\">Heavi-Watt Conductive Wire</link>"
msgstr "<link=\"WIREREFINEDHIGHWATTAGE\">大容量導電線</link>"

#. STRINGS.BUILDINGS.PREFABS.WIRERUBBER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WIRERUBBER.DESC"
msgid "It's quite unobtrusive, as far as wiring goes."
msgstr "配線にしてはかなり目立たない方です。"

#. STRINGS.BUILDINGS.PREFABS.WIRERUBBER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WIRERUBBER.EFFECT"
msgid ""
"Carries more <link=\"POWER\">Wattage</link> than a regular <link=\"WIREREFINED\">Conductive Wire</link> without overloading.\n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"通常の<link=\"WIREREFINED\">導電線</link>より大きな<link=\"POWER\">ワット数</link>を、過負荷を起こさずに扱えます。\n"
"\n"
"壁や床のタイル中に敷設することができます。"

#. STRINGS.BUILDINGS.PREFABS.WIRERUBBER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WIRERUBBER.NAME"
msgid "<link=\"WIRERUBBER\">Insulated Conductive Wire</link>"
msgstr "<link=\"WIRERUBBER\">絶縁導電線</link>"

#. STRINGS.BUILDINGS.PREFABS.WIRERUBBERBRIDGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WIRERUBBERBRIDGE.DESC"
msgid "Splitting generators onto separate systems can prevent overloads and wasted electricity."
msgstr "発電機の出力を複数の回路に分散させることで、過負荷や無駄な電力を防止できます。"

#. STRINGS.BUILDINGS.PREFABS.WIRERUBBERBRIDGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WIRERUBBERBRIDGE.EFFECT"
msgid ""
"Carries more <link=\"POWER\">Wattage</link> than a regular <link=\"WIREREFINEDBRIDGE\">Conductive Wire Bridge</link> without overloading.\n"
"\n"
"Runs one wire section over another without joining them.\n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"通常の<link=\"WIREREFINEDBRIDGE\">導電線ブリッジ</link>より大きな<link=\"POWER\">ワット数</link>を過負荷を起こさずに扱えます。\n"
"\n"
"回路を他と合流させずに、電線をまたいで回路を構成します。\n"
"\n"
"壁タイルや床タイルの中を通すことができます。"

#. STRINGS.BUILDINGS.PREFABS.WIRERUBBERBRIDGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WIRERUBBERBRIDGE.NAME"
msgid "<link=\"WIRERUBBERBRIDGE\">Insulated Conductive Wire Bridge</link>"
msgstr "<link=\"WIRERUBBERBRIDGE\">絶縁導電線ブリッジ</link>"

#. STRINGS.BUILDINGS.PREFABS.WOODENDOOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WOODENDOOR.DESC"
msgid "A breezy wooden door combines style and function."
msgstr "風通しの良い木製ドアはスタイルと機能性を兼ね備えています。"

#. STRINGS.BUILDINGS.PREFABS.WOODENDOOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WOODENDOOR.EFFECT"
msgid ""
"Encloses areas without blocking <link=\"ELEMENTSLIQUID\">Liquid</link> or <link=\"ELEMENTSGAS\">Gas</link> flow.\n"
"\n"
"Wild <link=\"CREATURES\">Critters</link> cannot pass through doors."
msgstr ""
"部屋の仕切りを作りますが、<link=\"ELEMENTSGAS\">気体</link>や<link=\"ELEMENTSLIQUID\">液体</link>は遮りません。\n"
"\n"
"野生<link=\"CREATURES\">動物</link>はドアを通り抜けることができません。"

#. STRINGS.BUILDINGS.PREFABS.WOODENDOOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WOODENDOOR.NAME"
msgid "<link=\"WOODENDOOR\">Wicker Door</link>"
msgstr "<link=\"WOODENDOOR\">木組みドア</link>"

#. STRINGS.BUILDINGS.PREFABS.WOODGASGENERATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WOODGASGENERATOR.DESC"
msgid "Wood burners are small and easy to maintain, but produce a fair amount of heat."
msgstr "薪ストーブは小型でメンテナンスしやすいですが、かなりの熱を発生させます。"

#. STRINGS.BUILDINGS.PREFABS.WOODGASGENERATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WOODGASGENERATOR.EFFECT"
msgid ""
"Burns <link=\"WOOD\">Wood</link> to produce electrical <link=\"POWER\">Power</link>.\n"
"\n"
"Produces <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> and <link=\"HEAT\">Heat</link>."
msgstr ""
"<link=\"WOOD\">木材</link>を燃やすことで<link=\"POWER\">発電</link>します。\n"
"\n"
"<link=\"CARBONDIOXIDE\">二酸化炭素</link>と<link=\"HEAT\">熱</link>を排出します。"

#. STRINGS.BUILDINGS.PREFABS.WOODGASGENERATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WOODGASGENERATOR.NAME"
msgid "<link=\"WOODGASGENERATOR\">Wood Burner</link>"
msgstr "<link=\"WOODGASGENERATOR\">薪ストーブ</link>"

#. STRINGS.BUILDINGS.PREFABS.WOODSCULPTURE.AVERAGEQUALITYNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WOODSCULPTURE.AVERAGEQUALITYNAME"
msgid "Mediocre Wood Sculpture"
msgstr "ありふれた木の彫像"

#. STRINGS.BUILDINGS.PREFABS.WOODSCULPTURE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WOODSCULPTURE.DESC"
msgid "A great fit for smaller spaces."
msgstr "小さなスペースにぴったりです。"

#. STRINGS.BUILDINGS.PREFABS.WOODSCULPTURE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WOODSCULPTURE.EFFECT"
msgid ""
"Moderately increases <link=\"DECOR\">Decor</link>, contributing to <link=\"MORALE\">Morale</link>.\n"
"\n"
"Must be sculpted by a Duplicant."
msgstr ""
"<link=\"DECOR\">装飾値</link>をほど良く増加させ、複製人間の<link=\"MORALE\">士気</link>を高めます。\n"
"\n"
"複製人間に彫刻してもらう必要があります。"

#. STRINGS.BUILDINGS.PREFABS.WOODSCULPTURE.EXCELLENTQUALITYNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WOODSCULPTURE.EXCELLENTQUALITYNAME"
msgid "Genius Wood Sculpture"
msgstr "天才的な木の彫像"

#. STRINGS.BUILDINGS.PREFABS.WOODSCULPTURE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WOODSCULPTURE.NAME"
msgid "<link=\"WOODSCULPTURE\">Wood Block</link>"
msgstr "<link=\"WOODSCULPTURE\">木の塊</link>"

#. STRINGS.BUILDINGS.PREFABS.WOODSCULPTURE.POORQUALITYNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WOODSCULPTURE.POORQUALITYNAME"
msgid "\"Abstract\" Wood Sculpture"
msgstr "木の彫像のようなもの"

#. STRINGS.BUILDINGS.PREFABS.WOODSTORAGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WOODSTORAGE.DESC"
msgid "Once it's empty, there's no use pining for more."
msgstr "一度空になると、これ以上望んでも無駄です。"

#. STRINGS.BUILDINGS.PREFABS.WOODSTORAGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WOODSTORAGE.EFFECT"
msgid "Stores a finite supply of <link=\"WOOD\">Wood</link>, which can be used for construction or to produce <link=\"HEAT\">Heat</link>."
msgstr "建築や<link=\"HEAT\">熱</link>を発生させるのに使える<link=\"WOOD\">木材</link>を保管します。"

#. STRINGS.BUILDINGS.PREFABS.WOODSTORAGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WOODSTORAGE.NAME"
msgid "Wood Pile"
msgstr "木材の山"

#. STRINGS.BUILDINGS.PREFABS.WOODTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WOODTILE.DESC"
msgid "Rooms built with wood tile are cozy and pleasant."
msgstr "木製タイルで作られた部屋は居心地がよく、快適です。"

