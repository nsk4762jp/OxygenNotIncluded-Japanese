msgid ""
"Space junk from a forgotten age.\n"
"\n"
"<link=\"EXOBASESDLC1\">Collecting artifacts</link> requires a rocket equipped with an <link=\"ARTIFACTCARGOBAY\">Artifact Transport Module</link>."
msgstr ""
