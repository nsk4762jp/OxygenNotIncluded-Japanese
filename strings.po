msgstr "泡や波の中に佇む、飾り気のない錨です。"

#. STRINGS.BLUEPRINTS.PERMIT_WALLS_SEA_ANCHOR.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_SEA_ANCHOR.NAME"
msgid "<link=\"EXTERIORWALL\">Minimalist Anchor</link>"
msgstr "<link=\"EXTERIORWALL\">ミニマリストアンカー</link>"

