msgctxt "STRINGS.CREATURES.PLANT_MUTATIONS.UNIDENTIFIED_DESC"
msgid "This seed must be identified at the <link=\"GENETICANALYSISSTATION\">Botanical Analyzer</link> before it can be planted."
msgstr "この種子を植える前に、<link=\"GENETICANALYSISSTATION\">植物分析機</link>で解析する必要があります。"

#. STRINGS.CREATURES.POOP.PLANT_POOP_STATION_WILD
msgctxt "STRINGS.CREATURES.POOP.PLANT_POOP_STATION_WILD"
