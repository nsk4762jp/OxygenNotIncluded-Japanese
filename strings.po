msgstr "<link=\"EXTERIORWALL\">ピクセルレックス</link>"

#. STRINGS.BLUEPRINTS.PERMIT_WALLS_SEA.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_SEA.DESC"
msgid "Unfussy waves and bubbles in a relaxing pattern."
msgstr "ゆったりとした波と泡が、リラックスできるパターンで描かれています。"

#. STRINGS.BLUEPRINTS.PERMIT_WALLS_SEA.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_SEA.NAME"
