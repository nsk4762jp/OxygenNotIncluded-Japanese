msgctxt "STRINGS.COLONY_ACHIEVEMENTS.ACTIVATEGEOTHERMALPLANT.REQUIREMENTS.REPAIR_CONTROLLER_DESCRIPTION"
msgid "Reconnect the Geothermal Heat Pump's plumbing"
msgstr "地熱ヒートポンプの配管システムを修復する"

