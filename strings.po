#. STRINGS.CREATURES.SPECIES.FILTERPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.FILTERPLANT.DESC"
msgid "Hydrocacti act as natural <link=\"WATER\">Water</link> filters when given access to <link=\"SAND\">Sand</link>."
msgstr "ミズサボテンは<link=\"SAND\">砂</link>を与えると自然の<link=\"WATER\">水</link>フィルターとして振舞います。"

#. STRINGS.CREATURES.SPECIES.FILTERPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.FILTERPLANT.DOMESTICATEDDESC"
msgid "This plant uses <link=\"SAND\">Sand</link> to convert <link=\"DIRTYWATER\">Polluted Water</link> into <link=\"WATER\">Water</link>."
msgstr "この植物は<link=\"DIRTYWATER\">汚染水</link>を<link=\"WATER\">水</link>に変換するために<link=\"SAND\">砂</link>を使用します。"

