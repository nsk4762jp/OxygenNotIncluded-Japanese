msgstr "<link=\"GEYSERGENERICSMALLVOLCANO\">小火山</link>"

#. STRINGS.CREATURES.SPECIES.GEYSER.SMALLREEFGEYSER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.SMALLREEFGEYSER.DESC"
msgid "An aquatic spring that periodically spouts highly pressurized <link=\"ELEMENTSLIQUID\">Liquid</link> drawn from its environment."
msgstr "周囲から<link=\"ELEMENTSLIQUID\">液体</link>を汲み上げ、それを高圧で噴出する水中間欠泉です。"

#. STRINGS.CREATURES.SPECIES.GEYSER.SMALLREEFGEYSER.LIQUID_CONSUMPTION
