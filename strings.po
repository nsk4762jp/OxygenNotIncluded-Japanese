msgid "A rocky vent that spouts <link=\"PROPANE\">Propane Gas</link>."
msgstr "<link=\"PROPANE\">プロパン(気体)</link>を噴出する、ごつごつした噴出孔です。"

#. STRINGS.CREATURES.SPECIES.PROPANESPOUT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PROPANESPOUT.NAME"
msgid "<link=\"GEYSERS\">Propane Spout</link>"
msgstr "<link=\"GEYSERS\">プロパン噴出孔</link>"

#. STRINGS.CREATURES.SPECIES.PUFFERFISH.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFFERFISH.BABY.DESC"
msgid ""
"A precious little Blowter Fry.\n"
"\n"
"In time, it will mature into an adult <link=\"PUFFERFISH\">Blowter</link>."
msgstr ""
"愛らしい小さなブローター幼体です。\n"
"\n"
"時間経過とともに成長し、<link=\"PUFFERFISH\">ブローター</link>になります。"

#. STRINGS.CREATURES.SPECIES.PUFFERFISH.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFFERFISH.BABY.NAME"
msgid "<link=\"SQUID\">Blowter Fry</link>"
msgstr "<link=\"PUFFERFISH\">ブローター幼体</link>"

#. STRINGS.CREATURES.SPECIES.PUFFERFISH.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFFERFISH.DESC"
msgid "Blowters are aquatic critters who produce <link=\"OXYGEN\">Oxygen</link> after eating leaves from <link=\"SEALETTUCE\">Waterweed</link> plants."
msgstr "ブローターは<link=\"SEALETTUCE\">水草</link>の葉を食べると<link=\"OXYGEN\">酸素</link>を生産する水棲動物です。"

#. STRINGS.CREATURES.SPECIES.PUFFERFISH.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFFERFISH.EGG_NAME"
msgid "<link=\"PUFFERFISH\">Blowter Egg</link>"
msgstr "<link=\"PUFFERFISH\">ブローターの卵</link>"

#. STRINGS.CREATURES.SPECIES.PUFFERFISH.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFFERFISH.NAME"
msgid "<link=\"PUFFERFISH\">Blowter</link>"
msgstr "<link=\"PUFFERFISH\">ブローター</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.BABY.DESC"
msgid ""
"A gassy little Puftlet.\n"
"\n"
"In time it will grow into an adult <link=\"PUFT\">Puft</link>."
msgstr ""
"小さなパフ幼体です。\n"
"\n"
"時間経過とともに成長し、<link=\"PUFT\">パフ</link>になります。"

#. STRINGS.CREATURES.SPECIES.PUFT.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.BABY.NAME"
msgid "<link=\"PUFT\">Puftlet</link>"
msgstr "<link=\"PUFT\">パフ幼体</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.DESC"
msgid "Pufts are non-aggressive critters that excrete lumps of <link=\"SLIMEMOLD\">Slime</link> with each breath."
msgstr "パフはおとなしい種族で、呼吸の度に<link=\"SLIMEMOLD\">ヘドロ</link>塊を排泄します。"

#. STRINGS.CREATURES.SPECIES.PUFT.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.EGG_NAME"
msgid "<link=\"PUFT\">Puft Egg</link>"
msgstr "<link=\"PUFT\">パフの卵</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.NAME"
msgid "<link=\"PUFT\">Puft</link>"
msgstr "<link=\"PUFT\">パフ</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.BABY.DESC"
msgid ""
"A gassy little Puftlet Prince.\n"
"\n"
"One day it will grow into an adult Puft morph, the <link=\"PUFTALPHA\">Puft Prince</link>.\n"
"\n"
"It seems a bit snobby..."
msgstr ""
"小さなパフ プリンス幼体です。\n"
"\n"
"時間経過とともに成長し、<link=\"PUFTALPHA\">パフ プリンス</link>になります。"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.BABY.NAME"
msgid "<link=\"PUFTALPHA\">Puftlet Prince</link>"
msgstr "<link=\"PUFTALPHA\">パフ プリンス幼体</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.DESC"
msgid "The Puft Prince is a lazy critter that excretes little <link=\"SOLID\">Solid</link> lumps of whatever it has been breathing."
msgstr "パフ プリンスは怠け者の種族で、呼吸の度に何かしらの<link=\"SOLID\">小塊</link>を排泄します。"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.EGG_NAME"
msgid "<link=\"PUFTALPHA\">Puft Prince Egg</link>"
msgstr "<link=\"PUFTALPHA\">パフ プリンスの卵</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.NAME"
msgid "<link=\"PUFTALPHA\">Puft Prince</link>"
msgstr "<link=\"PUFTALPHA\">パフ プリンス</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.BABY.DESC"
msgid ""
"A frazzled little Squeaky Puftlet.\n"
"\n"
"One day it will grow into an adult Puft morph, the <link=\"PUFTBLEACHSTONE\">Squeaky Puft</link>."
msgstr ""
"小さなやかまし パフ幼体です。\n"
"\n"
"時間経過とともに成長し、<link=\"PUFTBLEACHSTONE\">やかまし パフ</link>になります。"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.BABY.NAME"
msgid "<link=\"PUFTBLEACHSTONE\">Squeaky Puftlet</link>"
msgstr "<link=\"PUFTBLEACHSTONE\">やかまし パフ幼体</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.DESC"
msgid "Squeaky Pufts are non-aggressive critters that excrete lumps of <link=\"BLEACHSTONE\">Bleachstone</link> with each breath."
msgstr "やかまし パフはおとなしい種族で、呼吸の度に<link=\"BLEACHSTONE\">漂白石</link>を排泄します。"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.EGG_NAME"
msgid "<link=\"PUFTBLEACHSTONE\">Squeaky Puft Egg</link>"
msgstr "<link=\"PUFTBLEACHSTONE\">やかまし パフの卵</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.NAME"
msgid "<link=\"PUFTBLEACHSTONE\">Squeaky Puft</link>"
msgstr "<link=\"PUFTBLEACHSTONE\">やかまし パフ</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.BABY.DESC"
msgid ""
"A stocky little Dense Puftlet.\n"
"\n"
"One day it will grow into an adult Puft morph, the <link=\"PUFTOXYLITE\">Dense Puft</link>."
msgstr ""
"小さなこってり パフ幼体です。\n"
"\n"
"時間経過とともに成長し、<link=\"PUFTOXYLITE\">こってり パフ</link>になります。"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.BABY.NAME"
msgid "<link=\"PUFTOXYLITE\">Dense Puftlet</link>"
msgstr "<link=\"PUFTOXYLITE\">こってり パフ幼体</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.DESC"
msgid "Dense Pufts are non-aggressive critters that excrete condensed <link=\"OXYROCK\">Oxylite</link> with each breath."
msgstr "こってり パフはおとなしい種族で、呼吸の度に濃縮された<link=\"OXYROCK\">オキシライト</link>を排泄します。"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.EGG_NAME"
msgid "<link=\"PUFTOXYLITE\">Dense Puft Egg</link>"
msgstr "<link=\"PUFTOXYLITE\">こってり パフの卵</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.NAME"
msgid "<link=\"PUFTOXYLITE\">Dense Puft</link>"
msgstr "<link=\"PUFTOXYLITE\">こってり パフ</link>"

#. STRINGS.CREATURES.SPECIES.RAPTOR.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.RAPTOR.BABY.DESC"
msgid ""
"A feathery little Rhex fledgling.\n"
"\n"
"One day, it will grow into a fearsome <link=\"RAPTOR\">Rhex</link>."
msgstr ""
"羽毛が生えた小さなレックスの雛です。\n"
"\n"
"いつか成長し大人の<link=\"RAPTOR\">レックス</link>になるでしょう。"

#. STRINGS.CREATURES.SPECIES.RAPTOR.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.RAPTOR.BABY.NAME"
msgid "<link=\"RAPTOR\">Rhex Baby</link>"
msgstr "<link=\"RAPTOR\">レックスの赤ちゃん</link>"

# 収穫前のハネナンキン(Plume Squash Plant)と区別するため「の実」を付け足す
#. STRINGS.CREATURES.SPECIES.RAPTOR.DESC
msgctxt "STRINGS.CREATURES.SPECIES.RAPTOR.DESC"
msgid ""
"Rhexes are carnivorous critters that feed on smaller <link=\"CREATURES\">Critters</link> and produce <link=\"BRINEICE\">Brine Ice</link>.\n"
"\n"
"Their tailfeathers can be shorn for <link=\"FEATHERFABRIC\">Feather Fiber</link>."
msgstr ""
"レックスは小さな<link=\"CREATURES\">動物</link>を餌として食べる肉食動物で、<link=\"BRINEICE\">濃塩氷</link>を排泄します。\n"
"\n"
"尾羽は<link=\"FEATHERFABRIC\">羽毛繊維</link>として刈り取ることができます。"

#. STRINGS.CREATURES.SPECIES.RAPTOR.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.RAPTOR.EGG_NAME"
msgid "<link=\"RAPTOR\">Rhex Egg</link>"
msgstr "<link=\"RAPTOR\">レックスの卵</link>"

#. STRINGS.CREATURES.SPECIES.RAPTOR.NAME
msgctxt "STRINGS.CREATURES.SPECIES.RAPTOR.NAME"
msgid "<link=\"RAPTOR\">Rhex</link>"
msgstr "<link=\"RAPTOR\">レックス</link>"

#. STRINGS.CREATURES.SPECIES.SALTPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SALTPLANT.DESC"
msgid "Dasha Saltvines consume small amounts of <link=\"CHLORINEGAS\">Chlorine Gas</link> and form sodium deposits as they grow, producing harvestable <link=\"SALT\">Salt</link>."
msgstr "ダーシャ シオカズラは少量の<link=\"CHLORINEGAS\">塩素(気体)</link>を消費して成長とともにナトリウムを析出させ、収穫可能な<link=\"SALT\">塩</link>を生産します。"

#. STRINGS.CREATURES.SPECIES.SALTPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SALTPLANT.DOMESTICATEDDESC"
msgid "This plant produces unrefined <link=\"SALT\">Salt</link>."
msgstr "この植物は未精製の<link=\"SALT\">塩</link>を生産します。"

#. STRINGS.CREATURES.SPECIES.SALTPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SALTPLANT.NAME"
msgid "<link=\"SALTPLANT\">Dasha Saltvine</link>"
msgstr "<link=\"SALTPLANT\">ダーシャ シオカズラ</link>"

#. STRINGS.CREATURES.SPECIES.SALTYSTICKSPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SALTYSTICKSPLANT.DESC"
msgid "Sodicane produces <link=\"SALTYSTICKSFOOD\">Salty Sticks</link>, a sodium-rich <link=\"FOOD\">Food</link> that leaves Duplicants feeling quite parched."
msgstr "ソディケーンは<link=\"SALTYSTICKSFOOD\">プレッツェル</link>というナトリウム豊富な<link=\"FOOD\">食糧</link>を生産します。それを食べた複製人間は喉の渇きを覚えるでしょう。"

#. STRINGS.CREATURES.SPECIES.SALTYSTICKSPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SALTYSTICKSPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"SALTYSTICKSFOOD\">Salty Sticks</link>."
msgstr "この植物は食用の<link=\"SALTYSTICKSFOOD\">プレッツェル</link>を生産します。"

#. STRINGS.CREATURES.SPECIES.SALTYSTICKSPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SALTYSTICKSPLANT.NAME"
msgid "<link=\"SALTYSTICKSPLANT\">Sodicane</link>"
msgstr "<link=\"SALTYSTICKSPLANT\">ソディケーン</link>"

#. STRINGS.CREATURES.SPECIES.SAPTREE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SAPTREE.DESC"
msgid ""
"A <link=\"RESIN\">Sap</link>-producing cybernetic tree that shows signs of sentience.\n"
"\n"
"It is rooted firmly in place, and is waiting for some brave soul to bring it food."
msgstr ""
"<link=\"RESIN\">樹液</link>を生成し、知覚を示すサイバネ化された木です。\n"
"\n"
"しっかりと根付いており、給餌してくれる恐れ知らずを待ち構えています。"

#. STRINGS.CREATURES.SPECIES.SAPTREE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SAPTREE.NAME"
msgid "<link=\"SAPTREE\">Experiment 52B</link>"
msgstr "<link=\"SAPTREE\">実験体 52B</link>"

#. STRINGS.CREATURES.SPECIES.SEAFAIRY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAFAIRY.DESC"
msgid ""
"Kelpoles are non-hostile aquatic critters that spawn along <link=\"SEATREE\">Tower Kelp</link> stalks.\n"
"\n"
"They can be harvested for <link=\"NORI\">Nori</link>."
msgstr ""
"ケルポールは<link=\"SEATREE\">タワーケルプ</link>の茎に沿って発生する非敵対的な水棲動物です。\n"
"\n"
"彼らからは<link=\"NORI\">海苔</link>が採取できます。"

#. STRINGS.CREATURES.SPECIES.SEAFAIRY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAFAIRY.NAME"
msgid "<link=\"SEAFAIRY\">Kelpole</link>"
msgstr "<link=\"SEAFAIRY\">ケルポール</link>"

#. STRINGS.CREATURES.SPECIES.SEAHORSE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAHORSE.BABY.DESC"
msgid ""
"A flouncy little Seaquine Fry.\n"
"\n"
"In time, it will mature into an adult <link=\"SEAHORSE\">Seaquine</link>."
msgstr ""
"ひらひらした小さなシークイン幼体です。\n"
"\n"
"時間経過とともに成長し、<link=\"SEAHORSE\">シークイン</link>になります。"

#. STRINGS.CREATURES.SPECIES.SEAHORSE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAHORSE.BABY.NAME"
msgid "<link=\"SEAHORSE\">Seaquine Fry</link>"
msgstr "<link=\"SEAHORSE\">シークイン幼体</link>"

#. STRINGS.CREATURES.SPECIES.SEAHORSE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAHORSE.DESC"
msgid ""
"Seaquines are aquatic critters that live in liquid pools.\n"
"\n"
"They feed on <link=\"PEARL\">Pearl</link> and produce <link=\"FISHMILK\">Ovolene</link> at the <link=\"UNDERWATERMILKINGSTATION\">Aquatic Milking Station</link>."
msgstr ""
"シークインは液体プールの中で生活する水棲動物です。\n"
"\n"
"彼らは<link=\"PEARL\">真珠</link>を食べ、<link=\"UNDERWATERMILKINGSTATION\">水中搾乳端末</link>で<link=\"FISHMILK\">オボレン</link>を生産します。"

#. STRINGS.CREATURES.SPECIES.SEAHORSE.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAHORSE.EGG_NAME"
msgid "<link=\"SEAHORSE\">Seaquine Egg</link>"
msgstr "<link=\"SEAHORSE\">シークインの卵</link>"

#. STRINGS.CREATURES.SPECIES.SEAHORSE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAHORSE.NAME"
msgid "<link=\"SEAHORSE\">Seaquine</link>"
msgstr "<link=\"SEAHORSE\">シークイン</link>"

#. STRINGS.CREATURES.SPECIES.SEAL.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAL.BABY.DESC"
msgid ""
"A wobbly little Spigot Pup.\n"
"\n"
"In time, it will mature into an adult <link=\"SEAL\">Spigot Seal</link>."
msgstr ""
"無邪気で小さなパッキンアシカ幼体です。\n"
"\n"
"時間経過とともに成長し、<link=\"SEAL\">パッキンアシカ</link>になります。"

#. STRINGS.CREATURES.SPECIES.SEAL.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAL.BABY.NAME"
msgid "<link=\"SEAL\">Spigot Pup</link>"
msgstr "<link=\"SEAL\">パッキンアシカの幼体</link>"

#. STRINGS.CREATURES.SPECIES.SEAL.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAL.DESC"
msgid ""
"Spigot Seals are charismatic creatures who produce <link=\"ETHANOL\">Ethanol</link>.\n"
"\n"
"They eat <link=\"SUCROSE\">Sucrose</link>, and drink <link=\"SUGARWATER\">Nectar</link> straight from the <link=\"SPACETREE\">Bonbon Tree</link>."
msgstr ""
"パッキンアシカは<link=\"ETHANOL\">エタノール</link>を生成する魅力的な生き物です。\n"
"\n"
"彼らは<link=\"SUCROSE\">スクロース</link>を食べたり、<link=\"SPACETREE\">ボンボンツリー</link>から直接<link=\"SUGARWATER\">ネクター</link>を飲むのが大好きです。"

#. STRINGS.CREATURES.SPECIES.SEAL.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAL.EGG_NAME"
msgid "<link=\"SEAL\">Spigot Seal Egg</link>"
msgstr "<link=\"SEAL\">パッキンアシカの卵</link>"

#. STRINGS.CREATURES.SPECIES.SEAL.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAL.NAME"
msgid "<link=\"SEAL\">Spigot Seal</link>"
msgstr "<link=\"SEAL\">パッキンアシカ</link>"

# 塩水と濃塩水の両方を含む表現なので修正しました
#. STRINGS.CREATURES.SPECIES.SEALETTUCE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEALETTUCE.DESC"
msgid "Waterweeds thrive in liquid environments and can be harvested for fresh, edible <link=\"LETTUCE\">Lettuce</link>."
msgstr "水草は水中でよく育ち、新鮮な食用<link=\"LETTUCE\">レタス</link>を生産します。"

#. STRINGS.CREATURES.SPECIES.SEALETTUCE.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SEALETTUCE.DOMESTICATEDDESC"
msgid "This plant produces <link=\"LETTUCE\">Lettuce</link>."
msgstr "この植物は<link=\"LETTUCE\">レタス</link>を生産します。"

#. STRINGS.CREATURES.SPECIES.SEALETTUCE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEALETTUCE.NAME"
msgid "<link=\"SEALETTUCE\">Waterweed</link>"
msgstr "<link=\"SEALETTUCE\">水草</link>"

#. STRINGS.CREATURES.SPECIES.SEATREE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEATREE.DESC"
msgid ""
"Tower Kelp is an aquatic plant that grows in temperate pools.\n"
"\n"
"It can be harvested for <link=\"NORI\">Nori</link>."
msgstr ""
"タワーケルプは温帯プールで成長する水棲植物です。\n"
"\n"
"<link=\"NORI\">海苔</link>が採取できます。"

#. STRINGS.CREATURES.SPECIES.SEATREE.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SEATREE.DOMESTICATEDDESC"
msgid "This plant produces <link=\"NORI\">Nori</link>."
msgstr "この植物は<link=\"NORI\">海苔</link>を生産します。"

#. STRINGS.CREATURES.SPECIES.SEATREE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEATREE.NAME"
msgid "<link=\"SEATREE\">Tower Kelp</link>"
msgstr "<link=\"SEATREE\">タワーケルプ</link>"

#. STRINGS.CREATURES.SPECIES.SEATREEBRANCH.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEATREEBRANCH.DESC"
msgid ""
"These stalks are the individual shoots of the <link=\"SEATREE\">Tower Kelp</link> plant.\n"
"\n"
"They act as cross-species nurseries for <link=\"SEATREEFAIRY\">Kelpoles</link> that can be harvested for <link=\"NORI\">Nori</link>."
msgstr ""
"これらの茎は<link=\"SEATREE\">タワーケルプ</link>という植物の個々の芽です。\n"
"\n"
"これらは<link=\"SEATREEFAIRY\">ケルポール</link>繁殖のための苗床として機能し、<link=\"NORI\">海苔</link>としても採取できます。"

#. STRINGS.CREATURES.SPECIES.SEATREEBRANCH.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SEATREEBRANCH.DOMESTICATEDDESC"
msgid "This plant produces <link=\"NORI\">Nori</link>."
msgstr "この植物は<link=\"NORI\">海苔</link>を生産します。"

#. STRINGS.CREATURES.SPECIES.SEATREEBRANCH.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEATREEBRANCH.NAME"
msgid "<link=\"SEATREE\">Tower Kelp</link>"
msgstr "<link=\"SEATREE\">タワーケルプ</link>"

#. STRINGS.CREATURES.SPECIES.SEATURTLE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEATURTLE.BABY.DESC"
msgid "A chubby baby <link=\"SEATURTLE\">Orehull</link>"
msgstr "<link=\"SEATURTLE\">オレハル</link>の丸ぽちゃな赤ちゃんです。"

#. STRINGS.CREATURES.SPECIES.SEATURTLE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEATURTLE.BABY.NAME"
msgid "<link=\"SEATURTLE\">Orehull Spawn</link>"
msgstr "<link=\"SEATURTLE\">オレハルの幼生</link>"

#. STRINGS.CREATURES.SPECIES.SEATURTLE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEATURTLE.DESC"
msgid ""
"Orehulls are shy aquatic critters that eat <link=\"SEAFAIRYSPECIES\">Kelpoles</link> and excrete <link=\"TOXICMUD\">Polluted Mud</link>.\n"
"\n"
"They can be sheared for <link=\"IRONORE\">Iron Ore</link>."
msgstr ""
"オレハルは臆病な水棲動物で、<link=\"SEAFAIRYSPECIES\">ケルポール</link>を食べて<link=\"TOXICMUD\">汚泥</link>を排泄します。\n"
"\n"
"彼らからは<link=\"IRONORE\">鉄鉱石</link>が刈り取れます。"

#. STRINGS.CREATURES.SPECIES.SEATURTLE.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEATURTLE.EGG_NAME"
msgid "<link=\"SEATURTLE\">Orehull Egg</link>"
msgstr "<link=\"SEATURTLE\">オレハルの卵</link>"

#. STRINGS.CREATURES.SPECIES.SEATURTLE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEATURTLE.NAME"
msgid "<link=\"SEATURTLE\">Orehull</link>"
msgstr "<link=\"SEATURTLE\">オレハル</link>"

#. STRINGS.CREATURES.SPECIES.SEAURCHIN.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAURCHIN.DESC"
msgid ""
"Pinpoki grow in <link=\"URCHINPLANT\">Pinpokets</link>.\n"
"\n"
"They can be harvested for <link=\"URCHINMEAT\">Uni</link> and <link=\"DIAMOND\">Diamond</link>."
msgstr ""
"ピンポキは<link=\"URCHINPLANT\">ピンポケット</link>内で育ちます。\n"
"\n"
"これらからは<link=\"URCHINMEAT\">ウニ</link>と<link=\"DIAMOND\">ダイアモンド</link>が採取できます。"

#. STRINGS.CREATURES.SPECIES.SEAURCHIN.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAURCHIN.DOMESTICATEDDESC"
msgid "This plant produces <link=\"URCHINMEAT\">Uni</link>."
msgstr "この植物は<link=\"URCHINMEAT\">ウニ</link>を生産します。"

#. STRINGS.CREATURES.SPECIES.SEAURCHIN.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAURCHIN.NAME"
msgid "<link=\"URCHIN\">Pinpoki</link>"
msgstr "<link=\"URCHIN\">ピンポキ</link>"

#. STRINGS.CREATURES.SPECIES.SEEDS.BASICFABRICMATERIALPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEEDS.BASICFABRICMATERIALPLANT.DESC"
msgid ""
"The <link=\"PLANTS\">Seed</link> of a <link=\"BASICFABRICPLANT\">Thimble Reed</link>.\n"
"\n"
"Digging up Buried Objects may uncover a Thimble Reed Seed."
msgstr ""
"<link=\"BASICFABRICPLANT\">シンブル リード</link>の<link=\"PLANTS\">種子</link>です。\n"
"\n"
"埋もれた物体を掘り起こすとシンブル リードの種子を発見することがあります。"

#. STRINGS.CREATURES.SPECIES.SEEDS.BASICFABRICMATERIALPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEEDS.BASICFABRICMATERIALPLANT.NAME"
msgid "<link=\"BASICFABRICPLANT\">Thimble Reed Seed</link>"
msgstr "<link=\"BASICFABRICPLANT\">シンブル リードの種子</link>"

#. STRINGS.CREATURES.SPECIES.SEEDS.BASICSINGLEHARVESTPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEEDS.BASICSINGLEHARVESTPLANT.DESC"
msgid ""
"The <link=\"PLANTS\">Seed</link> of a <link=\"BASICSINGLEHARVESTPLANT\">Mealwood</link>.\n"
"\n"
"Digging up Buried Objects may uncover a Mealwood Seed."
msgstr ""
"<link=\"BASICSINGLEHARVESTPLANT\">ミールウッド</link>の<link=\"PLANTS\">種子</link>です。\n"
"\n"
"埋もれた物体を掘り起こすとミールウッドの種子を発見することがあります。"

#. STRINGS.CREATURES.SPECIES.SEEDS.BASICSINGLEHARVESTPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEEDS.BASICSINGLEHARVESTPLANT.NAME"
msgid "<link=\"BASICSINGLEHARVESTPLANT\">Mealwood Seed</link>"
msgstr "<link=\"BASICSINGLEHARVESTPLANT\">ミールウッドの種子</link>"

#. STRINGS.CREATURES.SPECIES.SEEDS.BEAN_PLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEEDS.BEAN_PLANT.DESC"
msgid ""
"The <link=\"PLANTS\">Seed</link> of a <link=\"BEANPLANT\">Nosh Sprout</link>.\n"
"\n"
"Digging up Buried Objects may uncover a Nosh Bean."
msgstr ""
"<link=\"BEANPLANT\">ノッシュの木</link>の<link=\"PLANTS\">種子</link>です。\n"
"\n"
"埋もれた物体を掘り起こすとノッシュ豆を発見することがあります。"

#. STRINGS.CREATURES.SPECIES.SEEDS.BEAN_PLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEEDS.BEAN_PLANT.NAME"
