msgstr "萎れペナルティ"

#. STRINGS.CREATURES.SPECIES.BUTTERFLY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.BUTTERFLY.DESC"
msgid ""
"Mimikas are airborne organisms that help nearby <link=\"PLANTS\">Plants</link> grow more quickly.\n"
"\n"
"When its leaves dry up, it will harden into <link=\"BUTTERFLYPLANTSEED\">Mimillet</link>."
msgstr ""
"ミミカは<link=\"PLANTS\">植物</link>の成長を助ける空中生物です。\n"
"\n"
"葉を乾燥させると固い<link=\"BUTTERFLYPLANT\">ミミレット</link>になります。"

#. STRINGS.CREATURES.SPECIES.BUTTERFLY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.BUTTERFLY.NAME"
msgid "<link=\"BUTTERFLY\">Mimika</link>"
msgstr "<link=\"BUTTERFLY\">ミミカ</link>"

#. STRINGS.CREATURES.SPECIES.BUTTERFLYPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.BUTTERFLYPLANT.DESC"
msgid ""
"Mimika Buds are self-harvesting plants that produce airborne <link=\"BUTTERFLY\">Mimikas</link>.\n"
"\n"
"<link=\"BUTTERFLY\">Mimikas</link> boost growth for nearby <link=\"PLANTS\">Plants</link> before hardening into <link=\"BUTTERFLYPLANTSEED\">Mimillet</link>."
msgstr ""
"ミミカのつぼみは、空中に<link=\"BUTTERFLY\">ミミカ</link>を生み出す自生植物です。\n"
"\n"
"<link=\"BUTTERFLY\">ミミカ</link>は、近くの<link=\"PLANTS\">植物</link>の成長を促進し、その後<link=\"BUTTERFLYPLANT\">ミミレット</link>へと成長します。"

#. STRINGS.CREATURES.SPECIES.BUTTERFLYPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.BUTTERFLYPLANT.DOMESTICATEDDESC"
msgid "This plant produces <link=\"BUTTERFLY\">Mimikas</link>."
msgstr "この植物は<link=\"BUTTERFLY\">ミミカ</link>を生産します。"

#. STRINGS.CREATURES.SPECIES.BUTTERFLYPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.BUTTERFLYPLANT.NAME"
msgid "<link=\"BUTTERFLYPLANT\">Mimika Bud</link>"
msgstr "<link=\"BUTTERFLYPLANT\">ミミカのつぼみ</link>"

#. STRINGS.CREATURES.SPECIES.CACTUSPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CACTUSPLANT.DESC"
msgid "Joyas are <link=\"DECOR\">Decorative</link> <link=\"PLANTS\">Plants</link> that are colloquially said to make gardeners \"jump for joy\"."
msgstr "ジョヤは庭師を喜びのあまりジャンプさせるといった口語表現の<link=\"DECOR\">観葉</link><link=\"PLANTS\">植物</link>です。"

#. STRINGS.CREATURES.SPECIES.CACTUSPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.CACTUSPLANT.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "この植物は<link=\"DECOR\">装飾</link>を改善します。"

#. STRINGS.CREATURES.SPECIES.CACTUSPLANT.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.CACTUSPLANT.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "成長ボーナス"

#. STRINGS.CREATURES.SPECIES.CACTUSPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CACTUSPLANT.NAME"
msgid "<link=\"CACTUSPLANT\">Jumping Joya</link>"
msgstr "<link=\"CACTUSPLANT\">ジャンピング ジョヤ</link>"

#. STRINGS.CREATURES.SPECIES.CACTUSPLANT.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.CACTUSPLANT.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "萎れペナルティ"

#. STRINGS.CREATURES.SPECIES.CARROTPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CARROTPLANT.DESC"
msgid "Plume Squashes are sweet, nutrient-rich tubers that can be harvested for <link=\"FOOD\">Food</link>."
msgstr "ハネナンキンは甘くて栄養豊富な根菜で、<link=\"FOOD\">食糧</link>として収穫できます。"

# 収穫前のハネナンキン(Plume Squash Plant)と区別するため「の実」を付け足す
#. STRINGS.CREATURES.SPECIES.CARROTPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.CARROTPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"CARROT\">Plume Squash</link>."
msgstr "この植物からは食用の<link=\"CARROT\">ハネナンキンの実</link>を収穫できます。"

#. STRINGS.CREATURES.SPECIES.CARROTPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CARROTPLANT.NAME"
msgid "<link=\"CARROTPLANT\">Plume Squash Plant</link>"
msgstr "<link=\"CARROTPLANT\">ハネナンキン</link>"

#. STRINGS.CREATURES.SPECIES.CHAMELEON.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CHAMELEON.BABY.DESC"
msgid ""
"A wide-eyed little Dartlet.\n"
"\n"
"Someday it will mature into a fully grown <link=\"CHAMELEON\">Dartle</link>."
msgstr ""
"まん丸お目目の小さなダートル幼体です。\n"
"\n"
"時間経過とともに成長し、<link=\"CHAMELEON\">ダートル</link>になります。"

#. STRINGS.CREATURES.SPECIES.CHAMELEON.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CHAMELEON.BABY.NAME"
msgid "<link=\"CHAMELEON\">Dartlet</link>"
msgstr "<link=\"CHAMELEON\">ダートル幼体</link>"

#. STRINGS.CREATURES.SPECIES.CHAMELEON.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CHAMELEON.DESC"
msgid ""
"Dartles are non-hostile critters who eat <link=\"DEWDRIP\">Dewdrips</link> and excrete <link=\"BLEACHSTONE\">Bleach Stone</link> and <link=\"CHLORINEGAS\">Chlorine Gas</link>.\n"
"\n"
"They are preyed on by <link=\"RAPTOR\">Rhexes</link>."
msgstr ""
"ダートルは非敵対的な動物で、<link=\"DEWDRIP\">ツユシボリのツユ</link>を食べて<link=\"BLEACHSTONE\">漂白石</link>と<link=\"CHLORINEGAS\">塩素(気体)</link>を排泄します。\n"
"\n"
"彼らは<link=\"RAPTOR\">レックス</link>の良い獲物です。"

#. STRINGS.CREATURES.SPECIES.CHAMELEON.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.CHAMELEON.EGG_NAME"
msgid "<link=\"CHAMELEON\">Dartle Egg</link>"
msgstr "<link=\"CHAMELEON\">ダートルの卵</link>"

#. STRINGS.CREATURES.SPECIES.CHAMELEON.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CHAMELEON.NAME"
msgid "<link=\"CHAMELEON\">Dartle</link>"
msgstr "<link=\"CHAMELEON\">ダートル</link>"

#. STRINGS.CREATURES.SPECIES.CHLORINEGEYSER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CHLORINEGEYSER.DESC"
msgid "A highly pressurized geyser that periodically erupts with <link=\"CHLORINEGAS\">Chlorine Gas</link>."
msgstr "定期的に<link=\"CHLORINEGAS\">塩素(気体)</link>を噴き上げる、高圧の間欠泉です。"

#. STRINGS.CREATURES.SPECIES.CHLORINEGEYSER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CHLORINEGEYSER.NAME"
msgid "<link=\"GEYSERGENERICCHLORINEGAS\">Chlorine Geyser</link>"
msgstr "<link=\"GEYSERGENERICCHLORINEGAS\">塩素間欠泉</link>"

#. STRINGS.CREATURES.SPECIES.CLAM.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CLAM.DESC"
msgid ""
"Clampums are aquatic bivalves that transform <link=\"SAND\">Sand</link> into <link=\"PEARL\">Pearl</link>.\n"
"\n"
"Due to their size, they can only be planted in a <link=\"WIDEFARMTILE\">Wide Hydroponic Farm</link>."
msgstr ""
"クランパンは<link=\"SAND\">砂</link>を<link=\"PEARL\">真珠</link>に変える二枚貝です。\n"
"\n"
"その大きさから、栽培できるのは<link=\"WIDEFARMTILE\">大型水耕タイル</link>のみとなっています。"

#. STRINGS.CREATURES.SPECIES.CLAM.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.CLAM.DOMESTICATEDDESC"
msgid "This organism produces <link=\"PEARL\">Pearl</link>."
msgstr "この生物は<link=\"PEARL\">真珠</link>を生産します。"

#. STRINGS.CREATURES.SPECIES.CLAM.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CLAM.NAME"
msgid "<link=\"CLAM\">Clampum</link>"
msgstr "<link=\"CLAM\">クランパン</link>"

#. STRINGS.CREATURES.SPECIES.COLDBREATHER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.COLDBREATHER.DESC"
msgid "Wheezeworts can be planted in <link=\"PLANTERBOX\">Planter Boxes</link>, <link=\"FARMTILE\">Farm Tiles</link> or <link=\"HYDROPONICFARM\">Hydroponic Farms</link>, and absorb <link=\"HEAT\">Heat</link> by respiring through their porous outer membranes."
msgstr "ウィーズウォートは<link=\"PLANTERBOX\">プランター</link>、<link=\"FARMTILE\">農耕タイル</link>、<link=\"HYDROPONICFARM\">水耕タイル</link>に植えることができ、多孔質の膜を通じた呼吸により<link=\"HEAT\">熱</link>を吸収します。"

#. STRINGS.CREATURES.SPECIES.COLDBREATHER.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.COLDBREATHER.DOMESTICATEDDESC"
msgid "This plant absorbs <link=\"HEAT\">Heat</link>."
msgstr "この植物は<link=\"HEAT\">熱</link>を吸収します。"

#. STRINGS.CREATURES.SPECIES.COLDBREATHER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.COLDBREATHER.NAME"
msgid "<link=\"COLDBREATHER\">Wheezewort</link>"
msgstr "<link=\"COLDBREATHER\">ウィーズウォート</link>"

#. STRINGS.CREATURES.SPECIES.COLDBREATHERCLUSTER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.COLDBREATHERCLUSTER.DESC"
msgid "Wheezeworts can be planted in <link=\"PLANTERBOX\">Planter Boxes</link>, <link=\"FARMTILE\">Farm Tiles</link> or <link=\"HYDROPONICFARM\">Hydroponic Farms</link>, and absorb <link=\"HEAT\">Heat</link> by respiring through their porous outer membranes."
msgstr "ウィーズウォートは<link=\"PLANTERBOX\">プランター</link>、<link=\"FARMTILE\">農耕タイル</link>、<link=\"HYDROPONICFARM\">水耕タイル</link>に植えることができ、多孔質の膜を通じた呼吸により<link=\"HEAT\">熱</link>を吸収します。"

#. STRINGS.CREATURES.SPECIES.COLDBREATHERCLUSTER.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.COLDBREATHERCLUSTER.DOMESTICATEDDESC"
msgid "This plant absorbs <link=\"HEAT\">Heat</link>."
msgstr "この植物は<link=\"HEAT\">熱</link>を吸収します。"

#. STRINGS.CREATURES.SPECIES.COLDBREATHERCLUSTER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.COLDBREATHERCLUSTER.NAME"
msgid "<link=\"COLDBREATHERCLUSTER\">Wheezewort</link>"
msgstr "<link=\"COLDBREATHERCLUSTER\">ウィーズウォート</link>"

#. STRINGS.CREATURES.SPECIES.COLDWHEAT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.COLDWHEAT.DESC"
msgid "Sleet Wheat produces <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>, a chilly grain that can be processed into <link=\"FOOD\">Food</link>."
msgstr "雪ん小麦には、<link=\"COLDWHEATSEED\">雪ん小麦の種籾</link>が実ります。この冷たい穀物は<link=\"FOOD\">食糧</link>に加工できます。"

#. STRINGS.CREATURES.SPECIES.COLDWHEAT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.COLDWHEAT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>."
msgstr "この植物は食用の<link=\"COLDWHEATSEED\">雪ん小麦の種籾</link>を生産します。"

#. STRINGS.CREATURES.SPECIES.COLDWHEAT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.COLDWHEAT.NAME"
msgid "<link=\"COLDWHEAT\">Sleet Wheat</link>"
msgstr "<link=\"COLDWHEAT\">雪ん小麦</link>"

#. STRINGS.CREATURES.SPECIES.CRAB.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.BABY.DESC"
msgid ""
"A snippy little Pokeshell Spawn.\n"
"\n"
"In time it will mature into a fully grown <link=\"CRAB\">Pokeshell</link>."
msgstr ""
"小さくて短気なポークシェルの幼生です。\n"
"\n"
"時間経過とともに成長し、<link=\"CRAB\">ポークシェル</link>になります。"

#. STRINGS.CREATURES.SPECIES.CRAB.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.BABY.NAME"
msgid "<link=\"CRAB\">Pokeshell Spawn</link>"
msgstr "<link=\"CRAB\">ポークシェルの幼生</link>"

#. STRINGS.CREATURES.SPECIES.CRAB.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.DESC"
msgid ""
"Pokeshells are nonhostile critters unless their eggs are nearby.\n"
"\n"
"They eat <link=\"TOXICSAND\">Polluted Dirt</link> and <link=\"COMPOST\">Rot Piles</link>.\n"
"\n"
"The shells they leave behind after molting can be crushed into <link=\"LIME\">Lime</link>."
msgstr ""
"ポークシェルは卵が近くにない限り、非敵対的な動物です。\n"
"\n"
"<link=\"TOXICSAND\">汚染土</link>と<link=\"COMPOST\">腐った塊</link>を食べます。\n"
"\n"
"彼らが脱皮の後に残す殻は、粉砕して<link=\"LIME\">石灰</link>にできます。"

#. STRINGS.CREATURES.SPECIES.CRAB.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.EGG_NAME"
msgid "<link=\"CRAB\">Pokeshell Roe</link>"
msgstr "<link=\"CRAB\">ハサミの子</link>"

#. STRINGS.CREATURES.SPECIES.CRAB.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.NAME"
msgid "<link=\"CRAB\">Pokeshell</link>"
msgstr "<link=\"CRAB\">ポークシェル</link>"

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.BABY.DESC"
msgid ""
"A picky little Sanishell Spawn.\n"
"\n"
"In time it will mature into a fully grown <link=\"CRABFRESHWATER\">Sanishell</link>."
msgstr ""
"小さくて気難し屋なサニシェルの幼生です。\n"
"\n"
"時間経過とともに成長し、<link=\"CRABFRESHWATER\">サニシェル</link>になります。"

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.BABY.NAME"
msgid "<link=\"CRABFRESHWATER\">Sanishell Spawn</link>"
msgstr "<link=\"CRABFRESHWATER\">サニシェルの幼生</link>"

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.DESC"
msgid ""
"Sanishells are nonhostile critters unless their eggs are nearby.\n"
"\n"
"They thrive in <link=\"WATER\">Water</link> and eliminate <link=\"DISEASE\">Germs</link> from any liquid they inhabit.\n"
"\n"
"They eat <link=\"TOXICSAND\">Polluted Dirt</link>, <link=\"SLIMEMOLD\">Slime</link> and <link=\"COMPOST\">Rot Piles</link>."
msgstr ""
"サニシェルは卵が近くにない限り、非敵対的な動物です。\n"
"\n"
"<link=\"WATER\">水</link>中で殖え、液体から<link=\"DISEASE\">病原菌</link>を取り除く習性を持っています。\n"
"\n"
"彼らは<link=\"TOXICSAND\">汚染土</link>、<link=\"SLIMEMOLD\">ヘドロ</link>、<link=\"COMPOST\">腐った塊</link>を食べます。"

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.EGG_NAME"
msgid "<link=\"CRABFRESHWATER\">Sanishell Roe</link>"
msgstr "<link=\"CRABFRESHWATER\">サニハサミの子</link>"

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.NAME"
msgid "<link=\"CRABFRESHWATER\">Sanishell</link>"
msgstr "<link=\"CRABFRESHWATER\">サニシェル</link>"

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.BABY.DESC"
msgid ""
"A knotty little Oakshell Spawn.\n"
"\n"
"In time it will mature into a fully grown <link=\"CRABWOOD\">Oakshell</link>."
msgstr ""
"小さくて節瘤だらけのオークシェルの幼生です。\n"
"\n"
"時間経過とともに成長し、<link=\"CRABWOOD\">オークシェル</link>になります。"

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.BABY.NAME"
msgid "<link=\"CRABWOOD\">Oakshell Spawn</link>"
msgstr "<link=\"CRABWOOD\">オークシェルの幼生</link>"

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.DESC"
msgid ""
"Oakshells are nonhostile critters unless their eggs are nearby.\n"
"\n"
"They eat <link=\"TOXICSAND\">Polluted Dirt</link>, <link=\"SLIMEMOLD\">Slime</link> and <link=\"COMPOST\">Rot Piles</link>.\n"
"\n"
"The shells they leave behind after molting can be crushed into <link=\"WOOD\">Wood</link>.\n"
"\n"
"Oakshells thrive in <link=\"ETHANOL\">Ethanol</link>."
msgstr ""
"オークシェルは卵が近くにない限り、非敵対的な動物です。\n"
"\n"
"<link=\"TOXICSAND\">汚染度</link>、<link=\"SLIMEMOLD\">ヘドロ</link>、<link=\"COMPOST\">腐った塊</link>を食べます。\n"
"\n"
"彼らが脱皮した後の抜け殻は粉砕することで<link=\"WOOD\">木材</link>になります。\n"
"\n"
"オークシェルは<link=\"ETHANOL\">エタノール</link>下で殖えます。"

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.EGG_NAME"
msgid "<link=\"CRABWOOD\">Oakshell Roe</link>"
msgstr "<link=\"CRABWOOD\">オークハサミの子</link>"

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.NAME"
msgid "<link=\"CRABWOOD\">Oakshell</link>"
msgstr "<link=\"CRABWOOD\">オークシェル</link>"

#. STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.DESC"
msgid "Critter Traps are carnivorous plants that consume small-to-medium-sized critters and release <link=\"HYDROGEN\">Hydrogen Gas</link> as waste."
msgstr "ケモノジゴクは不注意な動物を捕らえ消化する食肉植物です。<link=\"HYDROGEN\">水素(気体)</link>を排出します。"

#. STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.DOMESTICATEDDESC"
msgid "This plant eats small critters and produces <link=\"HYDROGEN\">Hydrogen Gas</link>."
msgstr "この植物は動物を捕食し、<link=\"HYDROGEN\">水素(気体)</link>を生産します。"

#. STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.HUNGRY
msgctxt "STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.HUNGRY"
msgid "Hungry"
msgstr "空腹"

# Venus’s Flytrap(ハエトリグサ) の捩り
#. STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.NAME"
msgid "<link=\"CRITTERTRAPPLANT\">Saturn Critter Trap</link>"
msgstr "<link=\"CRITTERTRAPPLANT\">ケモノジゴク</link>"

#. STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.PLANT_HUNGER_REQUIREMENT
msgctxt "STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.PLANT_HUNGER_REQUIREMENT"
msgid "Carnivorous Diet"
msgstr "肉食"

#. STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.VICTIM_IDENTIFIER
msgctxt "STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.VICTIM_IDENTIFIER"
msgid "Land Critters"
msgstr "陸上動物"

#. STRINGS.CREATURES.SPECIES.CYLINDRICA.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CYLINDRICA.DESC"
msgid "Bliss Bursts release an explosion of <link=\"DECOR\">Decor</link> into otherwise dull environments."
msgstr "ブリス バーストはイマイチぱっとしない環境に<link=\"DECOR\">装飾</link>の花火を打ち上げます。"

#. STRINGS.CREATURES.SPECIES.CYLINDRICA.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.CYLINDRICA.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "この植物は周囲の<link=\"DECOR\">装飾</link>を改善します。"

#. STRINGS.CREATURES.SPECIES.CYLINDRICA.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.CYLINDRICA.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "成長ボーナス"

#. STRINGS.CREATURES.SPECIES.CYLINDRICA.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CYLINDRICA.NAME"
msgid "<link=\"CYLINDRICA\">Bliss Burst</link>"
msgstr "<link=\"CYLINDRICA\">ブリス バースト</link>"

#. STRINGS.CREATURES.SPECIES.CYLINDRICA.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.CYLINDRICA.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "萎れペナルティ"

#. STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.DESC"
msgid "Dew Drippers produce <link=\"DEWDRIP\">Dewdrips</link> that can be crushed into <link=\"MILK\">Brackene</link>."
msgstr "ツユシボリは砕いて<link=\"MILK\">モー乳</link>にできる<link=\"DEWDRIP\">ツユシボリのツユ</link>を生産します。"

#. STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.DOMESTICATEDDESC"
msgid "This plant produces <link=\"MILK\">Brackene</link>."
msgstr "この植物は<link=\"MILK\">モー乳</link>を生産します。"

#. STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.NAME"
msgid "<link=\"DEWDRIPPERPLANT\">Dew Dripper</link>"
msgstr "<link=\"DEWDRIPPERPLANT\">ツユシボリ</link>"

#. STRINGS.CREATURES.SPECIES.DEWPALM.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DEWPALM.DESC"
msgid ""
"Gum Palms can be harvested for <link=\"PALMWOOD\">Gum Wood</link>, which can be processed into <link=\"LATEX\">Latex</link> at the <link=\"MILKPRESS\">Plant Pulverizer</link>.\n"
"\n"
"Due to their size, they can only be planted in a <link=\"WIDEFARMTILE\">Wide Hydroponic Farm</link>."
msgstr ""
"ゴムヤシからは<link=\"PALMWOOD\">ゴムウッド</link>を採取することができ、それは<link=\"MILKPRESS\">植物粉砕機</link>にかけることで<link=\"LATEX\">ラテックス</link>に加工できます。\n"
"\n"
"その大きさから、栽培できるのは<link=\"WIDEFARMTILE\">大型水耕タイル</link>のみとなっています。"

#. STRINGS.CREATURES.SPECIES.DEWPALM.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.DEWPALM.DOMESTICATEDDESC"
msgid "This plant produces <link=\"PALMWOOD\">Gum Wood</link>."
msgstr "この植物は<link=\"PALMWOOD\">ゴムウッド</link>を生産します。"

#. STRINGS.CREATURES.SPECIES.DEWPALM.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DEWPALM.NAME"
msgid "<link=\"DEWPALM\">Gum Palm</link>"
msgstr "<link=\"DEWPALM\">ゴムヤシ</link>"

#. STRINGS.CREATURES.SPECIES.DIESELMOO.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIESELMOO.DESC"
msgid ""
"Husky Moos are extraterrestrial critters that feed on <link=\"PLANTFIBER\">Plant Husk</link> and <link=\"GASGRASS\">Gas Grass</link>, and excrete <link=\"CARBONDIOXIDE\">Carbon Dioxide</link>.\n"
"\n"
"When domesticated and fed, they can be milked for <link=\"REFINEDLIPID\">Biodiesel</link>."
msgstr ""
"ハスキー モーは<link=\"PLANTFIBER\">植物の殻</link>や<link=\"GASGRASS\">ぷかぷか草</link>を食べて<link=\"CARBONDIOXIDE\">二酸化炭素</link>を排泄する大気外動物です。\n"
"\n"
"家畜化した後十分に餌を与えると、<link=\"REFINEDLIPID\">バイオディーゼル</link>を産出します。"

#. STRINGS.CREATURES.SPECIES.DIESELMOO.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIESELMOO.NAME"
msgid "<link=\"DIESELMOO\">Husky Moo</link>"
msgstr "<link=\"DIESELMOO\">ハスキー モー</link>"

#. STRINGS.CREATURES.SPECIES.DINOFERN.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DINOFERN.DESC"
msgid "Megafronds produce <link=\"FERNFOOD\">Megafrond Grain</link>, an ancient grain that can be processed into <link=\"FOOD\">Food</link>."
msgstr "巨大シダは<link=\"FERNFOOD\">巨大シダの顆粒</link>を生産し、この古い顆粒は<link=\"FOOD\">食糧</link>に加工されます。"

#. STRINGS.CREATURES.SPECIES.DINOFERN.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.DINOFERN.DOMESTICATEDDESC"
msgid "This plant produces <link=\"FERNFOOD\">Megafrond Grain</link>."
msgstr "この植物は<link=\"FERNFOOD\">巨大シダの顆粒</link>を生産します。"

#. STRINGS.CREATURES.SPECIES.DINOFERN.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DINOFERN.NAME"
msgid "<link=\"DINOFERN\">Megafrond</link>"
msgstr "<link=\"DINOFERN\">巨大シダ</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.BABY.DESC"
msgid ""
"A crawly little Sweetle Larva.\n"
"\n"
"In time, it will mature into an adult <link=\"DIVERGENTBEETLE\">Sweetle</link>."
msgstr ""
"むずむずする小さなスウィートル幼体です。\n"
"\n"
"時間経過とともに成長し、<link=\"DIVERGENTBEETLE\">スウィートル</link>になります。"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.BABY.NAME"
msgid "<link=\"DIVERGENTBEETLE\">Sweetle Larva</link>"
msgstr "<link=\"DIVERGENTBEETLE\">スウィートル幼体</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.DESC"
msgid ""
"Sweetles are nonhostile critters that excrete large amounts of <link=\"SUCROSE\">Sucrose</link>.\n"
"\n"
"They are closely related to the <link=\"DIVERGENTWORM\">Grubgrub</link> and exhibit similar, albeit less effective farming behaviors."
msgstr ""
"スウィートルは大量の個体<link=\"SUCROSE\">スクロース</link>を排泄する、非敵対的な動物です。\n"
"\n"
"彼らは<link=\"DIVERGENTWORM\">グラブグラブ</link>と近縁関係にあり、あまり効率的ではありませんが似たような農作業を行います。"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.EGG_NAME"
msgid "<link=\"DIVERGENTBEETLE\">Sweetle Egg</link>"
msgstr "<link=\"DIVERGENTBEETLE\">スウィートルの卵</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.NAME"
msgid "<link=\"DIVERGENTBEETLE\">Sweetle</link>"
msgstr "<link=\"DIVERGENTBEETLE\">スウィートル</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.BABY.DESC"
msgid ""
"A squirmy little Grubgrub Wormling.\n"
"\n"
"In time, it will mature into an adult <link=\"WORM\">Grubgrub</link> and drastically grow in size."
msgstr ""
"もぞもぞする小さなグラブグラブ幼体です。\n"
"\n"
"時間経過とともに成長し、とても巨大な<link=\"WORM\">グラブグラブ</link>になります。"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.BABY.NAME"
msgid "<link=\"DIVERGENTWORM\">Grubgrub Wormling</link>"
msgstr "<link=\"DIVERGENTWORM\">グラブグラブ幼体</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.DESC"
msgid ""
"Grubgrubs form symbiotic relationships with plants, especially <link=\"WORMPLANT\">Grubfruit Plants</link>, and instinctually tend to them.\n"
"\n"
"Grubgrubs are closely related to <link=\"DIVERGENTBEETLE\">Sweetles</link>."
msgstr ""
"グラブグラブは植物、特に<link=\"WORMPLANT\">グラブフルーツ</link>と共生関係を築いており、本能的に手入れをします。\n"
"\n"
"グラブグラブは<link=\"DIVERGENTBEETLE\">スウィートル</link>と近縁関係にあります。"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.EGG_NAME"
msgid "<link=\"DIVERGENTWORM\">Grubgrub Egg</link>"
msgstr "<link=\"DIVERGENTWORM\">グラブグラブの卵</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.NAME"
msgid "<link=\"DIVERGENTWORM\">Grubgrub</link>"
msgstr "<link=\"DIVERGENTWORM\">グラブグラブ</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.BABY.DESC"
msgid ""
"A little, bug-eyed Drecklet.\n"
"\n"
"In time it will mature into a fully grown <link=\"DRECKO\">Drecko</link>."
msgstr ""
"まん丸お目目の小さなドレッコ幼体です。\n"
"\n"
"時間経過とともに成長し、<link=\"DRECKO\">ドレッコ</link>になります。"

#. STRINGS.CREATURES.SPECIES.DRECKO.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.BABY.NAME"
msgid "<link=\"DRECKO\">Drecklet</link>"
msgstr "<link=\"DRECKO\">ドレッコ幼体</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.DESC"
msgid ""
"Dreckos are nonhostile critters that graze on <link=\"SPICEVINE\">Pincha Pepperplants</link>, <link=\"SWAMPLILY\">Balm Lily</link> or <link=\"BASICSINGLEHARVESTPLANT\">Mealwood Plants</link>.\n"
"\n"
"Their backsides are covered in thick woolly fibers that only grow in <link=\"HYDROGEN\">Hydrogen</link> climates."
msgstr ""
"ドレッコは生育中の<link=\"SPICEVINE\">ピンチャペッパー</link>、<link=\"SWAMPLILY\">バームリリー</link>、<link=\"BASICSINGLEHARVESTPLANT\">ミールウッド</link>のみを食する、非敵対的な動物です。\n"
"\n"
"彼らの背面は<link=\"HYDROGEN\">水素</link>下でのみ伸びる厚いウール繊維で覆われています。"

#. STRINGS.CREATURES.SPECIES.DRECKO.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.EGG_NAME"
msgid "<link=\"DRECKO\">Drecko Egg</link>"
msgstr "<link=\"DRECKO\">ドレッコの卵</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.NAME"
msgid "<link=\"DRECKO\">Drecko</link>"
msgstr "<link=\"DRECKO\">ドレッコ</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.BABY.DESC"
msgid ""
"A bug-eyed little Glossy Drecklet.\n"
"\n"
"In time it will mature into an adult Drecko morph, the <link=\"DRECKOPLASTIC\">Glossy Drecko</link>."
msgstr ""
"まん丸お目目の小さなつやつやドレッコ幼体です。\n"
"\n"
"時間経過とともに成長し、<link=\"DRECKOPLASTIC\">つやつやドレッコ</link>になります。"

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.BABY.NAME"
msgid "<link=\"DRECKOPLASTIC\">Glossy Drecklet</link>"
msgstr "<link=\"DRECKOPLASTIC\">つやつや ドレッコ幼体</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.DESC"
msgid ""
"Glossy Dreckos are nonhostile critters that graze on live <link=\"BASICSINGLEHARVESTPLANT\">Mealwood Plants</link> and <link=\"PRICKLEFLOWER\">Bristle Blossoms</link>.\n"
"\n"
"Their backsides are covered in bioplastic scales that only grow in <link=\"HYDROGEN\">Hydrogen Gas</link> climates."
msgstr ""
"つやつやドレッコは生育中の<link=\"BASICSINGLEHARVESTPLANT\">ミールウッド</link>および<link=\"PRICKLEFLOWER\">ブリッスル ブロッサム</link>のみを食する、非敵対的な動物です。\n"
"\n"
"彼らの背面は<link=\"HYDROGEN\">水素(気体)</link>下でのみ成長する生体プラスチックの鱗で覆われています。"

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.EGG_NAME"
msgid "<link=\"DRECKOPLASTIC\">Glossy Drecko Egg</link>"
msgstr "<link=\"DRECKOPLASTIC\">つやつや ドレッコの卵</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.NAME"
msgid "<link=\"DRECKOPLASTIC\">Glossy Drecko</link>"
msgstr "<link=\"DRECKOPLASTIC\">つやつや ドレッコ</link>"

#. STRINGS.CREATURES.SPECIES.EVILFLOWER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.DESC"
msgid "Sporechids have an eerily alluring appearance to mask the fact that they host particularly nasty strain of brain fungus."
msgstr "胞子ランは不気味なほどに魅力的な見た目をしています。まるで厄介な菌種である脳キノコの宿主であることを隠すように。"

#. STRINGS.CREATURES.SPECIES.EVILFLOWER.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link> but produces high quantities of <link=\"ZOMBIESPORES\">Zombie Spores</link>."
msgstr "この植物は周囲の<link=\"DECOR\">装飾</link>を改善しますが、大量の<link=\"ZOMBIESPORES\">ゾンビ胞子</link>も生産します。"

#. STRINGS.CREATURES.SPECIES.EVILFLOWER.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "成長ボーナス"

# Spore + Orchid のかばん語
#. STRINGS.CREATURES.SPECIES.EVILFLOWER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.NAME"
msgid "<link=\"EVILFLOWER\">Sporechid</link>"
msgstr "<link=\"EVILFLOWER\">胞子ラン</link>"

#. STRINGS.CREATURES.SPECIES.EVILFLOWER.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "萎れペナルティ"

#. STRINGS.CREATURES.SPECIES.FILAMENTPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.FILAMENTPLANT.DESC"
msgid ""
"Petta Poufs are <link=\"DECOR\">Decorative</link> aquatic <link=\"PLANTS\">Plants</link>.\n"
"\n"
"The gentle touch of their blooms soothes passing Duplicants' nerves."
msgstr ""
"ペッタ プフは水中<link=\"DECOR\">観葉</link><link=\"PLANTS\">植物</link>です。\n"
"\n"
"その花々の優しい感触は、通り過ぎる複製人間の神経を落ち着かせます。"

#. STRINGS.CREATURES.SPECIES.FILAMENTPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.FILAMENTPLANT.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "この植物は<link=\"DECOR\">装飾</link>を改善します。"

#. STRINGS.CREATURES.SPECIES.FILAMENTPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.FILAMENTPLANT.NAME"
